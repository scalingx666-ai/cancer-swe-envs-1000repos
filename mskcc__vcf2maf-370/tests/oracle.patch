diff --git a/vcf2maf.pl b/vcf2maf.pl
index e08e449..5889dd7 100755
--- a/vcf2maf.pl
+++ b/vcf2maf.pl
@@ -359,10 +359,18 @@ sub GetBiotypePriority {
             $cols[7]=~s/CT=([35]to[35])/Frame=$1/;
             $cols[7]=~s/SVMETHOD=([\w.]+)/Method=$1/;
             $cols[4] = "<" . $info{SVTYPE} . ">";
