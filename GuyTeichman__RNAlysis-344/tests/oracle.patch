+                    PUSH_AFTER: ${{ github.sha }}
+                run: |
+                    if [ "$EVENT_NAME" = "pull_request" ]; then
+                        from_ref="$PR_BASE"
+                        to_ref="$PR_HEAD"
+                    else
+                        to_ref="$PUSH_AFTER"
+                        from_ref="$PUSH_BEFORE"
+                        if [ -n "$from_ref" ] && [ "$from_ref" != "0000000000000000000000000000000000000000" ] \
