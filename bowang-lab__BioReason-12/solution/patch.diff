+        "                            # Also save raw content to a text file for easier manual fixing\n",
+        "                            with open(f\"{output_file}_raw.txt\", 'w', encoding='utf-8') as f:\n",
+        "                                f.write(content)\n",
+        "\n",
+        "                    except Exception as e:\n",
+        "                        print(f\"✗ Error processing result for {variant_id}: {e}\")\n",
