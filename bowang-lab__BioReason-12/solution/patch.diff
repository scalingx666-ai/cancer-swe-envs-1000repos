+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "no_pathway = [\"N00302\",\"N00303\",\"N00304\",\"N00305\",\"N00600\",\"N00643\",\"N00679\",\"N00789\",\"N01064\",\"N01065\",\"N01419\",\"N01422\",\"N01444\"]\n",
+    "for id in no_pathway:\n",
+    "    network_info.at[id, 'Pathway'] = pd.NA"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 94,
+   "id": "194ccc3a-54c5-483b-90d7-b5bcda4bdfe4",
