+   "outputs": [],
+   "source": [
+    "with open('all_variants_filtered.txt', 'r') as f:\n",
+    "    original_text = f.read()\n",
+    "\n",
+    "cleaned_text = remove_references(original_text)\n",
+    "\n",
+    "with open('all_variants_filtered.txt', 'w') as f:\n",
+    "    f.write(cleaned_text)"
+   ]
+  },
