+    "import re\n",
+    "\n",
+    "def remove_references(text):\n",
+    "    # This regex matches 'REFERENCE' lines and all subsequent indented lines (those starting with 2+ spaces)\n",
+    "    cleaned_text = re.sub(r'REFERENCE\\s+PMID:\\d+\\n(?: {2}.*\\n)*', '', text)\n",
+    "    return cleaned_text"
+   ]
+  },
