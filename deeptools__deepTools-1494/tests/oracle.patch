diff --git a/pydeeptools/deeptools/test/test_alignmentsieve.py b/pydeeptools/deeptools/test/test_alignmentsieve.py
index 338b96d06f..f3cf240171 100644
--- a/pydeeptools/deeptools/test/test_alignmentsieve.py
+++ b/pydeeptools/deeptools/test/test_alignmentsieve.py
@@ -155,3 +155,107 @@ def test_with_cram_output_with_shifts():
     aln_seive.main(args)
 
     _assert_equals(BAMFILE_OUT8, output_bam_file)
+
+
+def _bam_with_cell_barcodes(path: str) -> None:
+    """Copy the fixture, adding a CB tag derived from the read name."""
+    with pysam.AlignmentFile(BAMFILE_IN, "rb") as fin, pysam.AlignmentFile(path, "wb", template=fin) as fout:
+        for read in fin:
+            read.set_tag("CB", f"CELL{hash(read.query_name) % 7}-1")
+            fout.write(read)
+
+
+def test_alsieve_shift_drops_tags_by_default():
+    """Shifting without --keepTags drops every tag, SEQ and QUAL (unchanged behaviour)."""
+    _, inbam = tempfile.mkstemp(suffix=".bam")
+    _, outbam = tempfile.mkstemp(suffix=".bam")
+    _bam_with_cell_barcodes(inbam)
+    aln_seive.main(f"--bam {inbam} -o {outbam} --ATACshift".split())
+    with pysam.AlignmentFile(outbam, "rb") as f:
+        reads = list(f)
+    assert reads
+    assert all(not r.get_tags() for r in reads)
+
+
+def test_alsieve_keeptags_cb_matches_default_alignments():
+    """--keepTags CB keeps only CB, with the input value, and does not change positions."""
+    _, inbam = tempfile.mkstemp(suffix=".bam")
+    _, plain = tempfile.mkstemp(suffix=".bam")
+    _, kept = tempfile.mkstemp(suffix=".bam")
+    _bam_with_cell_barcodes(inbam)
+    aln_seive.main(f"--bam {inbam} -o {plain} --ATACshift".split())
+    aln_seive.main(f"--bam {inbam} -o {kept} --ATACshift --keepTags CB".split())
+    with pysam.AlignmentFile(inbam, "rb") as fi:
+        expected_cb = {(r.query_name, r.flag): r.get_tag("CB") for r in fi}
+    with pysam.AlignmentFile(plain, "rb") as fp, pysam.AlignmentFile(kept, "rb") as fk:
+        plain_reads, kept_reads = list(fp), list(fk)
+    assert len(plain_reads) == len(kept_reads) > 0
+    for p, k in zip(plain_reads, kept_reads):
+        assert (p.query_name, p.flag, p.reference_start, p.cigarstring, p.template_length) == (
+            k.query_name, k.flag, k.reference_start, k.cigarstring, k.template_length)
+        assert [t for t, _ in k.get_tags()] == ["CB"]
+        assert k.get_tag("CB") == expected_cb[(k.query_name, k.flag)]
+
+
+def test_alsieve_keeptags_copies_alignment_tags_verbatim():
+    """Tags describing the original alignment are not refused; they are copied as-is (here an integer tag)."""
+    _, inbam = tempfile.mkstemp(suffix=".bam")
+    _, outbam = tempfile.mkstemp(suffix=".bam")
+    with pysam.AlignmentFile(BAMFILE_IN, "rb") as fin, pysam.AlignmentFile(inbam, "wb", template=fin) as fout:
+        for read in fin:
+            read.set_tag("NM", len(read.query_name) % 5)
+            fout.write(read)
+    aln_seive.main(f"--bam {inbam} -o {outbam} --ATACshift --keepTags NM".split())
+    with pysam.AlignmentFile(outbam, "rb") as f:
+        reads = list(f)
+    assert reads
+    for r in reads:
+        assert r.get_tags() == [("NM", len(r.query_name) % 5)]
+
+
+def test_alsieve_keeptags_rejects_malformed_tag_names():
+    """Non-SAM tag names fail as a CLI error, not as a Rust panic (e.g. multi-byte characters)."""
+    _, outbam = tempfile.mkstemp(suffix=".bam")
+    for tag in ("éA", "A-", "1A", "C", "CBX"):
+        try:
+            aln_seive.main(["--bam", BAMFILE_IN, "-o", outbam, "--ATACshift", "--keepTags", tag])
+        except SystemExit as e:
+            assert "SAM tags" in str(e.code)
+        else:
+            raise AssertionError(f"--keepTags {tag!r} was accepted")
+
+
+def test_alsieve_keeptags_deduplicates():
+    """A repeated tag is accepted and written once per record."""
+    _, inbam = tempfile.mkstemp(suffix=".bam")
+    _, outbam = tempfile.mkstemp(suffix=".bam")
+    _bam_with_cell_barcodes(inbam)
+    for tags in ("--keepTags CB CB", "--keepTags CB --keepTags CB"):
+        aln_seive.main(f"--bam {inbam} -o {outbam} --ATACshift {tags}".split())
+        with pysam.AlignmentFile(outbam, "rb") as f:
+            reads = list(f)
+        assert reads
+        assert all([t for t, _ in r.get_tags()] == ["CB"] for r in reads)
+
+def test_alsieve_keeptags_repeated_option_accumulates():
+    """--keepTags CB --keepTags UB keeps both tags, not just the last group."""
+    inbam = tempfile.mkstemp(suffix=".bam")[1]
+    outbam = tempfile.mkstemp(suffix=".bam")[1]
+    with pysam.AlignmentFile(BAMFILE_IN) as src, pysam.AlignmentFile(inbam, "wb", template=src) as dst:
+        for r in src:
+            r.set_tag("CB", "AAAC")
+            r.set_tag("UB", "TTTG")
+            dst.write(r)
+    aln_seive.main(f"--bam {inbam} -o {outbam} --ATACshift --keepTags CB --keepTags UB".split())
+    with pysam.AlignmentFile(outbam) as out:
+        for r in out:
+            assert sorted(t for t, _ in r.get_tags()) == ["CB", "UB"]
+
+def test_alsieve_keeptags_needs_shift_and_bam_output():
+    _, outbam = tempfile.mkstemp(suffix=".bam")
+    for extra in ("", "--ATACshift --BED"):
+        try:
+            aln_seive.main(f"--bam {BAMFILE_IN} -o {outbam} --keepTags CB {extra}".split())
+        except SystemExit:
+            continue
+        raise AssertionError(f"--keepTags CB {extra!r} was accepted")
