+#Count number of variants which were outside confidence region based on vcfeval annotated vcf
+task CountUNKVcfEval {
+    input {
+        File? vcf=""
+        File? vcfIndex=""
+        Int? preemptible
+        Int? memoryMaybe
+        String gatkTag
+    }
+    Int memoryDefault = 16
