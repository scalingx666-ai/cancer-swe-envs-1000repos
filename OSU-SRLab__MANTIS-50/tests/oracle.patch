-    for length in tumor.keys():
-        lengths.add(length)
-    lengths = sorted(lengths)
-    for length in lengths:
-        n_repeats = 0
-        t_repeats = 0
-        if length in normal:
-            n_repeats = normal[length]
-        if length in tumor:
-            t_repeats = tumor[length]
-        output.append([length, n_repeats, t_repeats])
