-    @staticmethod
-    def kmer_repeat_count(kmer, sequence, offset = 0):
-        repeats = 0
-        klen = len(kmer)
-        while True:
-            if sequence[offset:offset+klen] != kmer:
-                # End of repeat sequence
-                break
-            repeats += 1
-            offset += klen
-            if offset > len(sequence):
-                # End of sequence
-                break
-        return repeats
-    # end .kmer_repeat_count()
