@@ -191,6 +190,56 @@
     "fig = mv.plotfig()"
    ]
   },
+  {
+   "attachments": {},
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "- Set user-defined custom color handle function by `set_custom_color_func` method"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 3,
+   "metadata": {},
+   "outputs": [
+    {
+     "data": {
+      "image/png": "",
+      "text/plain": [
+       "<Figure size 854x120 with 1 Axes>"
+      ]
+     },
+     "metadata": {},
+     "output_type": "display_data"
+    }
+   ],
+   "source": [
+    "from pymsaviz import MsaViz, get_msa_testdata\n",
+    "from Bio.Align import MultipleSeqAlignment\n",
+    "\n",
+    "msa_file = get_msa_testdata(\"MRGPRG.fa\")\n",
+    "mv = MsaViz(msa_file, start=100, end=160, show_grid=True)\n",
+    "\n",
+    "def custom_color_func(\n",
+    "    row_pos: int, col_pos: int, seq_char: str, msa: MultipleSeqAlignment\n",
+    ") -> str:\n",
+    "    # Note: Both `row_pos` and `col_pos` are 0-index starts\n",
+    "    if col_pos < 120 and seq_char != \"-\":\n",
+    "        return \"salmon\"\n",
+    "    if 120 <= col_pos < 140:\n",
+    "        if seq_char in (\"A\", \"V\", \"P\"):\n",
+    "            return \"skyblue\"\n",
+    "        else:\n",
+    "            return \"lightyellow\"\n",
+    "    if col_pos >= 140 and 1 <= row_pos <= 4:\n",
+    "        return \"lime\"\n",
+    "    return \"white\"\n",
+    "\n",
+    "mv.set_custom_color_func(custom_color_func)\n",
+    "fig = mv.plotfig()"
+   ]
+  },
   {
    "cell_type": "markdown",
    "metadata": {},
