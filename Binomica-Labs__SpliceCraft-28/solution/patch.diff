+            "amplicon uniqueness is not established")
+
+    def _primer_result(role: str) -> dict:
+        full = primers[role]
+        hp = _mut_hairpin_dg(full)
+        hd = _mut_homodimer_dg(full)
+        if hp is None or hd is None:
