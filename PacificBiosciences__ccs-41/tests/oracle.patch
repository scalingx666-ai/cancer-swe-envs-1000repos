-def regex(pattern, s):
-    """Match a regular expression or return False if invalid.
-
-    >>> [bool(regex(r, 'foobar')) for r in ('foo.*', '***')]
-    [True, False]
-    """
-    try:
-        return re.match(pattern + r'\Z', s)
-    except re.error:
-        return False
