diff --git a/R/rnaseq.R b/R/rnaseq.R
index 1d6877d3..2dd75c72 100644
--- a/R/rnaseq.R
+++ b/R/rnaseq.R
@@ -150,7 +150,28 @@ getRNASeqQuantGenomeInfo <- function(gse) {
 #'
 #' @keywords internal
 readRNAQuantAnnotation <- function(link) {
+  # NCBI serves the shared annotation files on the web download endpoint
+  # behind a Google reCAPTCHA page, so readr gets HTML back (#235). Read the
+  # FTP mirror copy instead when it exists (currently human only).
+  fname <- if (grepl("^https?://", link)) extractFilenameFromDownloadURL(link)
+  if (!is.null(fname)) {
+    ftp <- paste0("https://ftp.ncbi.nlm.nih.gov/geo/rnaseq_counts/annot/", fname)
+    resp <- httr2::request(ftp) |>
+      httr2::req_timeout(15) |>
+      httr2::req_method("HEAD") |>
+      httr2::req_error(is_error = function(resp) FALSE) |>
+      httr2::req_perform()
+    if (httr2::resp_status(resp) == 200) link <- ftp
+  }
   annotation <- as.data.frame(readr::read_tsv(link, show_col_types = FALSE))
+  if (!"GeneID" %in% names(annotation)) {
+    stop(
+      "The gene annotation file at\n  ", link,
+      "\nis not a GEO annotation table (no 'GeneID' column). NCBI may be ",
+      "blocking automated downloads of this file; try downloading it in a ",
+      "browser."
+    )
+  }
   rownames(annotation) <- as.character(annotation$GeneID)
   return(annotation)
 }
diff --git a/tests/testthat/test_rnaseq_annotation.R b/tests/testthat/test_rnaseq_annotation.R
new file mode 100644
index 00000000..270873c9
--- /dev/null
+++ b/tests/testthat/test_rnaseq_annotation.R
@@ -0,0 +1,6 @@
+test_that("readRNAQuantAnnotation errors clearly on a non-annotation file (#235)", {
+  # NCBI can serve an HTML reCAPTCHA page instead of the TSV
+  html <- tempfile(fileext = ".tsv")
+  writeLines(c("<!doctype html><html>", "<body>captcha</body>"), html)
+  expect_error(GEOquery:::readRNAQuantAnnotation(html), "no 'GeneID' column")
+})
