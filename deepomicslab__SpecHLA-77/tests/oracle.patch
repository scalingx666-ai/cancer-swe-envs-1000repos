     ;;
     j) num_threads="$OPTARG"
     ;;
+    F) force_fermikit_single_thread=1
+    ;;
     w) weight_imb="$OPTARG"
     ;;
     u) focus_exon="$OPTARG"
@@ -241,7 +246,7 @@ if [ $focus_exon_flag == 1 ];then #exon
 else # full length
   assemble_region=$dir/select.region.txt
 fi
