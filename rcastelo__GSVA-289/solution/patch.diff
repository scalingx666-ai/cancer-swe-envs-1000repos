+
+  if (!(nzs > 0 && ctx->sparse)) {
+    for (int i=0; i < p; i++) {
+      if (r[i] != NA_INTEGER)
+        symrnkstat[i] = fabs(((double) (p - *nnas)) / 2.0 - ((double) r[i]));
+      else
+        symrnkstat[i] = NA_REAL;
+    }
+  }
+
+  return 0;
+}
diff --git a/src/ranks.h b/src/ranks.h
new file mode 100644
index 00000000..c889fb4d
--- /dev/null
+++ b/src/ranks.h
@@ -0,0 +1,46 @@
+#ifndef RANKS_H
+#define RANKS_H
+
+#include <R.h>
+#include <Rdefines.h>
+
+/* type codes of the rank matrix */
+#define RANKSTYPE_MATRIX_INT   1
+#define RANKSTYPE_MATRIX_DBL   2
+#define RANKSTYPE_DGC          3
+#define RANKSTYPE_SVT_INT      4
+#define RANKSTYPE_SVT_DBL      5
+
+/* context for fetching the columns of a rank matrix, which is created once
+ * per call to gsva_score_genesets_R() and holds a pointer to the data of the
+ * rank matrix, according to its class, and a buffer of 'p' integers that is
+ * reused to fetch every column */
+typedef struct ranks_ctx_s {
+  int      type;       /* RANKSTYPE_* */
+  union {
+    const void* data;  /* dense matrix: INTEGER() or REAL() pointer */
+    struct { const int* i; const int* p; const double* x; } dgc;
+    SEXP svt;          /* SVT slot of a SVT_SparseMatrix */
+  } u;
+  int      p;          /* number of rows/genes/features */
+  int      n;          /* number of columns/samples/cells/spots */
+  Rboolean sparse;
+  int    (*fetch_col)(struct ranks_ctx_s* ctx, int j);
+  int*     r;          /* buffer with the last fetched column */
+} ranks_ctx_t;
+
+const char*
+get_class_name(SEXP obj);
+
+ranks_ctx_t*
+ranks_ctx_create(SEXP XR, Rboolean intrnks, Rboolean sparse);
+
+int
+ranks2stats(ranks_ctx_t* ctx, int j, int* decordstat, double* symrnkstat,
+            int* nzeros_col, double* zerosymrnkstat);
+
+int
+ranks2stats_nas(ranks_ctx_t* ctx, int j, int* decordstat, double* symrnkstat,
+                int* nzeros_col, double* zerosymrnkstat, int* nnas);
+
+#endif
diff --git a/src/rnd_walk.c b/src/rnd_walk.c
new file mode 100644
index 00000000..37f0ae6e
--- /dev/null
+++ b/src/rnd_walk.c
@@ -0,0 +1,295 @@
+#include <stdlib.h>
+#include <math.h>
+#include <R_ext/Utils.h>
+#include "rnd_walk.h"
+
+/* memory is allocated with R_alloc(), which is released by R when the .Call()
+ * returns, also on error()
+ */
+rndwalk_ctx_t*
+rndwalk_ctx_create(SEXP genesetsidxR) {
+  int            m = length(genesetsidxR);
+  int            maxk = 0;
+  rndwalk_ctx_t* ctx;
+
+  for (int j=0; j < m; j++) {
+    int k = length(VECTOR_ELT(genesetsidxR, j));
+    if (k > maxk)
+      maxk = k;
+  }
+
+  ctx = (rndwalk_ctx_t*) R_alloc(1, sizeof(rndwalk_ctx_t));
+  ctx->maxk = maxk;
+  ctx->ranks = (int*) R_alloc(maxk, sizeof(int));
+  ctx->idx = (int*) R_alloc(maxk, sizeof(int));
+  ctx->scores = (double*) R_alloc(maxk, sizeof(double));
+
+  return ctx;
+}
+
+/* the random walk is undefined, and its maximum deviations are set to NA,
+ * when its in-gene-set or its out-gene-set steps sum up to zero. the latter
+ * happens when the gene set contains all (nonmissing) genes and the former
+ * when all genes in the gene set have a zero symmetric rank statistic, e.g.,
+ * a single gene at the middle rank p/2 of a dense column with p even, or only
+ * zero-expressed genes in a sparse column with a single nonzero value.
+ *
+ * the maximum and minimum deviations of the walk are computed without walking
+ * through the 'n' genes: the walk goes up only at the positions of the 'k'
+ * genes of the gene set and goes down at every other position, so its maximum
+ * is attained right after a step up and its minimum right before one. after
+ * sorting the genes of the gene set by position, at the i-th of them (0-based)
+ * there are (rank - i) genes outside the gene set ranked above it, which gives
+ * the value of the walk right before (current_valley) and right after
+ * (current_peak) its step up. the positions are sorted with R_qsort_int_I(),
+ * which also permutes the indices of the genes to read their weights in that
+ * order. walking through the genes in the gene set reduces the original O(p)
+ * -O(n) in the code- computational cost to O(k log k) time. note that gene
+ * gene indices in 'gsetidx' are assumed to be unique, which is guaranteed by
+ * the R code that maps gene sets to features.
+ *
+ * returned value: 1 if the random walk is undefined, 0 otherwise
+ */
+int
+gsva_rnd_walk(rndwalk_ctx_t* ctx, int* gsetidx, int k, int* decordstat,
+              double* symrnkstat, int n, double tau, double* walkstatpos,
+              double* walkstatneg) {
+  int*         ranks = ctx->ranks;
+  int*         idx = ctx->idx;
+  double*      scores = ctx->scores;
+  double       total_pos_sum = 0.0;
+  double       running_pos_sum = 0.0;
+  double       max_peak = 0.0;
+  double       min_valley = 0.0;
+  double       neg_step;
+
+  *walkstatpos = *walkstatneg = NA_REAL;
+  if (k == 0 || k == n) /* no in-gene-set or no out-gene-set steps */
+    return 1;
+
+  for (int i=0; i < k; i++) {
+    /* convert 1-based gene indices and positions to 0-based ! */
+    int gene_idx = gsetidx[i] - 1;
+
+    ranks[i] = decordstat[gene_idx] - 1;
+    idx[i] = i; /* reset on every call: R_qsort_int_I() permutes 'idx' in
+                 * place, and it must start as 0..k-1 to pair each sorted
+                 * position in 'ranks' with its weight in 'scores' */
+    scores[i] = tau == 1 ? symrnkstat[gene_idx] :
+                           pow(symrnkstat[gene_idx], tau);
+    total_pos_sum += scores[i];
+  }
+
+  if (total_pos_sum == 0.0) /* in-gene-set steps sum up to zero */
+    return 1;
+
+  R_qsort_int_I(ranks, idx, 1, k);
+
+  neg_step = 1.0 / ((double) (n - k));
+  for (int i=0; i < k; i++) {
+    double neg_penalty = ((double) (ranks[i] - i)) * neg_step;
+    double current_valley, current_peak;
+
+    current_valley = running_pos_sum / total_pos_sum - neg_penalty;
+    if (current_valley < min_valley)
+      min_valley = current_valley;
+
+    running_pos_sum += scores[idx[i]];
+
+    current_peak = running_pos_sum / total_pos_sum - neg_penalty;
+    if (current_peak > max_peak)
+      max_peak = current_peak;
+  }
+
+  *walkstatpos = max_peak;
+  *walkstatneg = min_valley;
+
+  return 0;
+}
+
+/* returned value: 1 if the random walk is undefined, 0 otherwise
+ * see gsva_rnd_walk()
+ */
+int
+gsva_sparse_rnd_walk(int* gsetidx, int k, int* decordstat, double* symrnkstat,
+                     int n, double tau, int nzeros, double zerosymrnkstat,
+                     double* walkstatpos, double* walkstatneg) {
+  int     nnz, gset_nnz, gset_nzeros;
+  int*    gsetrnk;
+  int*    gsetrnk_nnz;
+  int*    gsetidx_nnz;
+  double* stepcdfingeneset;
+  int*    stepcdfoutgeneset;
+  int     undefined;
+
+  nnz = n - nzeros;
+
+  gsetrnk = R_Calloc(k, int);
+  gsetrnk_nnz = R_Calloc(k, int);
+  gsetidx_nnz = R_Calloc(k, int);
+  gset_nnz = gset_nzeros = 0;
+
+  for (int i=0; i < k; i++) {
+    gsetrnk[i] = decordstat[gsetidx[i]-1];
+    if (gsetrnk[i] <= nnz) { /* assuming nonzeros expression values are positive */
+      gsetrnk_nnz[gset_nnz] = gsetrnk[i];
+      gsetidx_nnz[gset_nnz] = gsetidx[i];
+      gset_nnz++;
+    } else
+      gset_nzeros++;
+  }
+
+  stepcdfingeneset = R_Calloc(n, double);  /* assuming zeros are set */
+  stepcdfoutgeneset = R_Calloc(n, int);
+  for (int i=0; i < n; i++)
+    stepcdfoutgeneset[i] = 1;
+
+  if (gset_nnz > 0) { /* if there are nonzero expression values in the gene set */
+    for (int i=0; i < gset_nnz; i++) {
+      /* convert 1-based gene indices to 0-based ! */
+      if (tau == 1)
+        stepcdfingeneset[gsetrnk_nnz[i]-1] = symrnkstat[gsetidx_nnz[i]-1];
+      else
+        stepcdfingeneset[gsetrnk_nnz[i]-1] = pow(symrnkstat[gsetidx_nnz[i]-1], tau);
+      stepcdfoutgeneset[gsetrnk_nnz[i]-1] = 0;
+    }
+  }
+
+  R_Free(gsetrnk);
+  R_Free(gsetrnk_nnz);
+  R_Free(gsetidx_nnz);
+
+  if (gset_nzeros > 0) { /* if there are zero expression values in the gene set */
+    int*   gsetrnk_zeros;
+    double step = 0;
+
+    if (gset_nzeros > 1)
+      step = (double) (nzeros - 1) / (double) (gset_nzeros - 1);
+
+    gsetrnk_zeros = R_Calloc(gset_nzeros, int);
+    for (int i=0; i < gset_nzeros; i++)
+      gsetrnk_zeros[i] = ((int) round(((double) i) * step + 1)) + nnz;
+
+    for (int i=0; i < gset_nzeros; i++) {
+      /* convert 1-based gene indices to 0-based ! */
+      if (tau == 1)
+        stepcdfingeneset[gsetrnk_zeros[i]-1] = zerosymrnkstat;
+      else
+        stepcdfingeneset[gsetrnk_zeros[i]-1] = pow(zerosymrnkstat, tau);
+      stepcdfoutgeneset[gsetrnk_zeros[i]-1] = 0;
+    }
+
+    R_Free(gsetrnk_zeros);
+  }
+
+  for (int i=1; i < n; i++) {
+    stepcdfingeneset[i] = stepcdfingeneset[i-1] + stepcdfingeneset[i];
+    stepcdfoutgeneset[i] = stepcdfoutgeneset[i-1] + stepcdfoutgeneset[i];
+  }
+
+  *walkstatpos = *walkstatneg = NA_REAL;
+  undefined = !(stepcdfingeneset[n-1] > 0 && stepcdfoutgeneset[n-1] > 0);
+  if (!undefined) {
+    *walkstatpos = *walkstatneg = 0;
+    for (int i=0; i < n; i++) {
+      double wlkstat = ((double) stepcdfingeneset[i]) /
+                       ((double) stepcdfingeneset[n-1]) -
+                       ((double) stepcdfoutgeneset[i]) /
+                       ((double) stepcdfoutgeneset[n-1]);
+
+      if (wlkstat > *walkstatpos)
+        *walkstatpos = wlkstat;
+      if (wlkstat < *walkstatneg)
+        *walkstatneg = wlkstat;
+    }
+  }
+
+  R_Free(stepcdfoutgeneset);
+  R_Free(stepcdfingeneset);
+
+  return undefined;
+}
+
+/* 'n' is the number of nonmissing genes in the column, i.e., the length of
+ * the random walk, since nonmissing genes have decreasing order statistics
+ * between 1 and 'n', and missing genes are left out of the walk.
+ * returned value: 1 if the random walk is undefined, 0 otherwise, see
+ * gsva_rnd_walk(); a gene set with missing values under na_use < 3 or with
+ * less than 'minsize' nonmissing genes does not lead to an undefined walk
+ */
+int
+gsva_rnd_walk_nas(int* gsetidx, int k, int* decordstat, double* symrnkstat,
+                  int n, double tau, int na_use, int minsize,
+                  double* walkstatpos, double* walkstatneg, int* wna) {
+  int*    gsetidx_wonas;
+  int*    gsetrnk;
+  double* stepcdfingeneset;
+  int*    stepcdfoutgeneset;
+  int     k_notna = 0;
+  int     undefined = 0;
+
+  gsetidx_wonas = R_Calloc(k, int);
+  gsetrnk = R_Calloc(k, int);
+
+  for (int i=0; i < k; i++) {
+    if (decordstat[gsetidx[i]-1] != NA_INTEGER) { /* na.rm skips NAs */
+      gsetidx_wonas[k_notna] = gsetidx[i];
+      gsetrnk[k_notna] = decordstat[gsetidx[i]-1];
+      k_notna++;
+    } else {
+      if (na_use < 3) { /* everything or all.obs */
+        R_Free(gsetrnk);
+        R_Free(gsetidx_wonas);
+        return 0;
+      }
+    }
+  }
+
+  *walkstatpos = *walkstatneg = NA_REAL;
+  if (k_notna >= minsize) { /* na.rm */
+    stepcdfingeneset = R_Calloc(n, double);  /* assuming zeroes are set */
+    stepcdfoutgeneset = R_Calloc(n, int);
+    for (int i=0; i < n; i++)
+      stepcdfoutgeneset[i] = 1;
+
+    for (int i=0; i < k_notna; i++) {
+      /* convert 1-based gene indices to 0-based ! */
+      if (tau == 1)
+        stepcdfingeneset[gsetrnk[i]-1] = symrnkstat[gsetidx_wonas[i]-1];
+      else
+        stepcdfingeneset[gsetrnk[i]-1] = pow(symrnkstat[gsetidx_wonas[i]-1], tau);
+      stepcdfoutgeneset[gsetrnk[i]-1] = 0;
+    }
+
+    for (int i=1; i < n; i++) {
+      stepcdfingeneset[i] = stepcdfingeneset[i-1] + stepcdfingeneset[i];
+      stepcdfoutgeneset[i] = stepcdfoutgeneset[i-1] + stepcdfoutgeneset[i];
+    }
+
+    undefined = !(stepcdfingeneset[n-1] > 0 && stepcdfoutgeneset[n-1] > 0);
+    if (!undefined) {
+      *walkstatpos = *walkstatneg = 0;
+      for (int i=0; i < n; i++) {
+        double wlkstat = ((double) stepcdfingeneset[i]) /
+                         ((double) stepcdfingeneset[n-1]) -
+                         ((double) stepcdfoutgeneset[i]) /
+                         ((double) stepcdfoutgeneset[n-1]);
+
+        if (wlkstat > *walkstatpos)
+          *walkstatpos = wlkstat;
+        if (wlkstat < *walkstatneg)
+          *walkstatneg = wlkstat;
+      }
+    }
+
+    R_Free(stepcdfoutgeneset);
+    R_Free(stepcdfingeneset);
+
+  } else
+    *wna = 1;
+
+  R_Free(gsetrnk);
+  R_Free(gsetidx_wonas);
+
+  return undefined;
+}
diff --git a/src/rnd_walk.h b/src/rnd_walk.h
new file mode 100644
index 00000000..9983a22d
--- /dev/null
+++ b/src/rnd_walk.h
@@ -0,0 +1,35 @@
+#ifndef RND_WALK_H
+#define RND_WALK_H
+
+#include <R.h>
+#include <Rinternals.h>
+
+/* context for the dense random walk, created once per call to
+ * gsva_score_genesets_R(), with a buffer sized for the largest gene set
+ * that is reused for every gene set and column */
+typedef struct {
+  int     maxk;   /* size of the largest gene set */
+  int*    ranks;  /* 0-based positions of the genes in the gene set */
+  int*    idx;    /* permutation applied to 'ranks' by the sort */
+  double* scores; /* weights of the genes in the gene set */
+} rndwalk_ctx_t;
+
+rndwalk_ctx_t*
+rndwalk_ctx_create(SEXP genesetsidxR);
+
+int
+gsva_rnd_walk(rndwalk_ctx_t* ctx, int* gsetidx, int k, int* decordstat,
+              double* symrnkstat, int n, double tau, double* walkstatpos,
+              double* walkstatneg);
+
+int
+gsva_sparse_rnd_walk(int* gsetidx, int k, int* decordstat, double* symrnkstat,
+                     int n, double tau, int nzeros, double zerosymrnkstat,
+                     double* walkstatpos, double* walkstatneg);
+
+int
+gsva_rnd_walk_nas(int* gsetidx, int k, int* decordstat, double* symrnkstat,
+                  int n, double tau, int na_use, int minsize,
+                  double* walkstatpos, double* walkstatneg, int* wna);
+
+#endif
diff --git a/src/score_genesets.c b/src/score_genesets.c
new file mode 100644
index 00000000..a959a762
--- /dev/null
+++ b/src/score_genesets.c
@@ -0,0 +1,189 @@
+#include <math.h>
+#include <string.h>
+#include <R.h>
+#include <Rdefines.h>
+#include <cli/progress.h>
+#include "ranks.h"
+#include "rnd_walk.h"
+
+/* global variables */
+extern SEXP GSVA_attrNAsSym,
+            GSVA_attrUndefWalksSym;
+
+/* figures out whether 'obj' is a matrix, dgCMatrix or SVT_SparseMatrix
+ * and returns the class name */
+const char*
+get_class_name(SEXP obj) {
+    if (isMatrix(obj))
+        return "matrix";
+
+    SEXP classR = getAttrib(obj, R_ClassSymbol);
+    return CHAR(STRING_ELT(classR, 0));
+}
+
+SEXP
+gsva_score_genesets_R(SEXP ranksR, SEXP genesetsidxR, SEXP intrnksR,
+                      SEXP sparseR, SEXP maxdiffR, SEXP absrnkR, SEXP tauR,
+                      SEXP anynaR, SEXP nauseR, SEXP minsizeR, SEXP verboseR) {
+  int      p, n, nnas;
+  int      m = length(genesetsidxR);
+  Rboolean intrnks=asLogical(intrnksR);
+  Rboolean sparse=asLogical(sparseR);
+  Rboolean maxdiff=asLogical(maxdiffR);
+  Rboolean absrnk=asLogical(absrnkR);
+  double   tau=REAL(tauR)[0];
+  Rboolean anyna=asLogical(anynaR);
+  int      nause=INTEGER(nauseR)[0]; /* everything=1, all.obs=2, na.rm=3 */
+  int      minsize=INTEGER(minsizeR)[0];
+  SEXP     esR;
+  double*  es;
+  int      wna=0;
+  double   nundefwalks=0; /* double to avoid overflowing m x n */
+  Rboolean abort=FALSE;
+  Rboolean verbose=asLogical(verboseR);
+  SEXP     pb=R_NilValue;
+  int      nunprotect=0;
+  int*     decordstat_col;
+  double*  symrnkstat_col;
+  int      nzeros_col=0;
+  double   zerosymrnkstat=0;
+  int      invalidranks=0;
+  ranks_ctx_t*   rankctx;
+  rndwalk_ctx_t* walkctx;
+
+  /* memory below is allocated with R_alloc(), which is released by R when
+   * this function returns, also on error() */
+  rankctx = ranks_ctx_create(ranksR, intrnks, sparse);
+  p = rankctx->p; /* number of rows/genes/features */
+  n = rankctx->n; /* number of columns/samples/cells/spots */
+
+  walkctx = rndwalk_ctx_create(genesetsidxR);
+
+  decordstat_col = (int*) R_alloc(p, sizeof(int));
+  symrnkstat_col = (double*) R_alloc(p, sizeof(double));
+
+  PROTECT(esR = allocMatrix(REALSXP, m, n)); nunprotect++;
+  es = REAL(esR);
+
+  if (verbose) {
+    pb = PROTECT(cli_progress_bar(n, NULL)); nunprotect++; /* one tick per column */
+    cli_progress_set_name(pb, "Calculating GSVA scores");
+  }
+
+  for (int i=0; i < n; i++) {
+    if (verbose) { /* show progress */
+      if (i % 100 == 0 && CLI_SHOULD_TICK)
+        cli_progress_set(pb, i);
+    }
+
+    nnas = 0;
+    if (anyna)
+      invalidranks = ranks2stats_nas(rankctx, i, decordstat_col,
+                                     symrnkstat_col, &nzeros_col,
+                                     &zerosymrnkstat, &nnas);
+    else
+      invalidranks = ranks2stats(rankctx, i, decordstat_col, symrnkstat_col,
+                                 &nzeros_col, &zerosymrnkstat);
+
+    /* ranks out of range would lead to reading and writing out of the
+     * bounds of the arrays used in the random walk */
+    if (invalidranks) {
+      if (verbose)
+        cli_progress_done(pb);
+      UNPROTECT(nunprotect); /* esR pb */
+      if (invalidranks == 2)
+        error("GSVA ranks have missing values, but the GSVA parameters "
+              "indicate that the input data has none, e.g., because "
+              "'checkNA=\"no\"' was used in 'gsvaParam()'.");
+      else
+        error("GSVA ranks are out of range for the %d rows of the input "
+              "data. This may happen when rows are removed after "
+              "calculating the ranks with 'gsvaColRanks()'; remove them "
+              "before calling 'gsvaRowNorm()' instead.", p);
+    }
+
+    for (int j=0; j < m; j++) {
+      SEXP     gsetidxR = VECTOR_ELT(genesetsidxR, j);
+      int*     gsetidx;
+      int      k = length(gsetidxR);
+#ifdef LONG_VECTOR_SUPPORT
+      R_xlen_t idx = (R_xlen_t) m * i + j;
+#else
+      int      idx = (size_t) m * i + j;
+#endif
+      double  walkstatpos, walkstatneg;
+      int     undefwalk = 0;
+
+      walkstatpos = walkstatneg = NA_REAL;
+      gsetidx = INTEGER(gsetidxR);
+      if (anyna) {
+        undefwalk = gsva_rnd_walk_nas(gsetidx, k, decordstat_col,
+                                      symrnkstat_col, p - nnas, tau, nause,
+                                      minsize, &walkstatpos, &walkstatneg,
+                                      &wna);
+      } else {
+        if (sparse && nzeros_col > 0)
+          undefwalk = gsva_sparse_rnd_walk(gsetidx, k, decordstat_col,
+                                           symrnkstat_col, p, tau, nzeros_col,
+                                           zerosymrnkstat, &walkstatpos,
+                                           &walkstatneg);
+        else
+          undefwalk = gsva_rnd_walk(walkctx, gsetidx, k, decordstat_col,
+                                    symrnkstat_col, p, tau, &walkstatpos,
+                                    &walkstatneg);
+      }
+      nundefwalks = nundefwalks + undefwalk;
+
+      es[idx] = NA_REAL;
+      if (!anyna || (!ISNA(walkstatpos) && !ISNA(walkstatneg))) {
+	      if (maxdiff) {
+		      es[idx] = walkstatpos + walkstatneg;
+          if (absrnk)
+            es[idx] = walkstatpos - walkstatneg;
+	      } else {
+		        es[idx] = (walkstatpos > fabs(walkstatneg)) ? walkstatpos : walkstatneg;
+	      }
+      } else {
+        /* an undefined random walk is not caused by missing values */
+        if (anyna && !undefwalk && nause == 2) { /* all.obs */
+          abort=TRUE;
+          break;
+        }
+      }
+    }
+    if (abort)
+      break;
+  }
+
+  if (anyna) {
+    SEXP attr;
+
+    if (nause == 2 && abort) {
+      PROTECT(attr = allocVector(STRSXP, 1));
+      SET_STRING_ELT(attr, 0, mkChar("abort"));
+      Rf_setAttrib(esR, GSVA_attrNAsSym, attr);
+      UNPROTECT(1); /* attr */
+    } else if (nause == 3 && wna == 1) {
+      PROTECT(attr = allocVector(STRSXP, 1));
+      SET_STRING_ELT(attr, 0, mkChar("wna"));
+      Rf_setAttrib(esR, GSVA_attrNAsSym, attr);
+      UNPROTECT(1); /* attr */
+    }
+  }
+
+  /* report the number of NA scores coming from undefined random walks */
+  if (nundefwalks > 0) {
+    SEXP attr;
+
+    PROTECT(attr = ScalarReal(nundefwalks));
+    Rf_setAttrib(esR, GSVA_attrUndefWalksSym, attr);
+    UNPROTECT(1); /* attr */
+  }
+
+  if (verbose)
+    cli_progress_done(pb);
+
+  UNPROTECT(nunprotect); /* esR pb */
+
+  return(esR);
+}
