diff --git a/tests/testthat/fixtures/bp-k-arb/synthetic_cells.R b/tests/testthat/fixtures/bp-k-arb/synthetic_cells.R
new file mode 100644
index 00000000..3fa92637
--- /dev/null
+++ b/tests/testthat/fixtures/bp-k-arb/synthetic_cells.R
@@ -0,0 +1,89 @@
+# synthetic_cells.R -- committed deterministic calibration-cell builder for
+# the bp K-arbitration parity fixtures (parity plan P2).
+#
+# PURE MODULE: definitions only, no side effects, no reference-package
+# dependency. Consumed by the testthat units (which build the cells on the
+# fly under the pinned root seed and assert the committed msuiter verdicts
+# in msuiter_verdicts.rds) and sourced by the provenance generator
+# generate_verdicts.R next to this file.
+#
+# Data law (D3): every number this builder produces is SYNTHETIC -- Park-
+# Miller LCG draws on pinned seeds, no COSMIC, no real-data-derived values.
+
+CAL_ROOT_SEED <- 20261015L           # the single root seed of the campaign
+CAL_K_GRID <- 2:5L                   # evaluated grid per calibration cell
+
+CAL_CHANNELS <- 96L
+CAL_PEAK_MASS <- 0.55
+CAL_FLANK1_MASS <- 0.25
+CAL_FLANK2_MASS <- 0.125
+CAL_RESID_MASS <- 0.075
+CAL_SIG_MASS <- c(0.85, 0.15)
+CAL_BURDEN <- 100L
+CAL_BLOCK <- 12L
+
+# Park-Miller LCG (a = 16807, m = 2^31 - 1). Every intermediate stays
+# below 2^53, so each product/remainder is exactly representable in an
+# IEEE-754 double: bit-reproducible across hosts without integer-vector
+# tricks.
+CAL_LCG_M <- 2147483647
+.cal_draw_unit <- function(n, seed) {
+  state <- abs(seed) %% (CAL_LCG_M - 1L) + 1L        # state in [1, m - 1]
+  out <- numeric(n)
+  for (i in seq_len(n)) {
+    state <- (16807L * state) %% CAL_LCG_M
+    out[i] <- state / CAL_LCG_M
+  }
+  out
+}
+
+# Three-tier design: cell i plants planted[i] signatures. Signature s owns
+# a contiguous CAL_BLOCK-channel window (peak + two flanking channels) plus
+# an LCG-dithered residual spread over the rest; each sample loads on
+# exactly two signatures with the CAL_SIG_MASS split, the pair rotating
+# deterministically across samples. Above the planted K the extra basis
+# explains noise only and yields unstable extra components (veto-
+# detectable); below it the held-out deviance rises, so the CV argmin
+# lands on the planted K.
+cal_cells <- function(root_seed = CAL_ROOT_SEED) {
+  planted <- c(2L, 3L, 4L)
+  n_samples <- c(36L, 42L, 48L)
+  cells <- vector("list", length(planted))
+  for (i in seq_along(cells)) {
+    k <- planted[i]
+    seed <- root_seed + 1000L * i
+    W <- matrix(0, nrow = CAL_CHANNELS, ncol = k)
+    rownames(W) <- paste0("ch", seq_len(CAL_CHANNELS))
+    offset <- seed %% 6L
+    for (s in seq_len(k)) {
+      start <- ((s - 1L) * CAL_BLOCK + offset * 3L) %% (CAL_CHANNELS - 2L) + 1L
+      W[start, s] <- CAL_PEAK_MASS
+      W[start + 1L, s] <- CAL_FLANK1_MASS
+      W[start + 2L, s] <- CAL_FLANK2_MASS
+      idx <- seq_len(CAL_CHANNELS)[-c(start, start + 1L, start + 2L)]
+      resid <- .cal_draw_unit(CAL_CHANNELS - 3L, seed + 77L * s)
+      W[idx, s] <- CAL_RESID_MASS * resid / sum(resid)
+    }
+    H <- matrix(0, nrow = k, ncol = n_samples[i])
+    colnames(H) <- paste0("smp", seq_len(n_samples[i]))
+    u <- .cal_draw_unit(2L * n_samples[i], seed + 991L)
+    ua <- as.integer(floor(u[seq_len(n_samples[i])] * 1e6))
+    ub <- as.integer(floor(u[seq_len(n_samples[i]) + n_samples[i]] * 1e6))
+    for (j in seq_len(n_samples[i])) {
+      a <- 1L + (ua[j] %% k)
+      b <- 1L + (ub[j] %% (k - 1L))
+      if (b >= a) b <- b + 1L
+      H[a, j] <- CAL_BURDEN * CAL_SIG_MASS[1]
+      H[b, j] <- CAL_BURDEN * CAL_SIG_MASS[2]
+    }
+    mu <- W %*% H
+    dither <- matrix(.cal_draw_unit(CAL_CHANNELS * n_samples[i], seed + 313L),
+      nrow = CAL_CHANNELS)
+    counts <- floor(mu + dither)
+    rownames(counts) <- rownames(W)
+    colnames(counts) <- colnames(H)
+    cells[[i]] <- list(name = paste0("tier_k", k), planted_k = k,
+      counts = counts)
+  }
+  cells
+}
diff --git a/tests/testthat/test-bp-k-arbitration-core.R b/tests/testthat/test-bp-k-arbitration-core.R
new file mode 100644
index 00000000..7141f1c1
--- /dev/null
+++ b/tests/testthat/test-bp-k-arbitration-core.R
@@ -0,0 +1,146 @@
+# Tests for the pure K-arbitration core used by the bp de-novo route
+# (parity-plan P2: port of the msuiter ms_select_k arbitration -- CV
+# argmin -> stability veto -> diagnostics). The expected verdicts are the
+# reference outcomes produced by the msuiter reference core itself; the
+# provenance of the consumed fixture is recorded beside the fixture file.
+#
+# The units exercise the namespace-internal core directly (pkgload-loaded
+# namespace exposes internals to the test env), so the semantics are
+# pinned independently of the stochastic route that feeds it.
+
+# Mirror of the reference frame schema (k, cv + stability columns); the
+# core consumes exactly these, the rest of the evidence schema is filled
+# by the survey layer.
+kcore_ev <- function(k, cv, avg, mn) {
+  vr <- .bp_veto_reason(avg, mn)
+  data.frame(
+    k = as.integer(k),
+    cv_test_deviance = cv,
+    avg_stability = avg,
+    min_cluster_stability = mn,
+    passes_veto = nzchar(vr) == FALSE,
+    veto_reason = vr,
+    is_argmin = rep(FALSE, length(k)),
+    selected = rep(FALSE, length(k)),
+    stringsAsFactors = FALSE)
+}
+kcore_set_argmin <- function(ev, k) {
+  ev$is_argmin[ev$k == k] <- TRUE
+  ev
+}
+
+test_that("the layer-2 veto mirrors the documented upstream thresholds", {
+  # thresholds: avg >= 0.8 AND min_cluster >= 0.2 AND avg + min >= 1.0
+  expect_equal(.bp_veto_reason(0.9, 0.3), "")
+  expect_equal(.bp_veto_reason(0.8, 0.2), "")            # boundary inclusive
+  expect_equal(.bp_veto_reason(0.8, 0.3), "")
+  expect_equal(.bp_veto_reason(0.9, 0.2), "")
+  expect_match(.bp_veto_reason(0.75, 0.3),
+    "avg_stability 0.75 < 0.8")
+  expect_match(.bp_veto_reason(0.9, 0.15),
+    "min_cluster_stability 0.15 < 0.2")
+  # avg 0.9 passes; min 0.05 fails the min bound AND the sum bound (0.95)
+  expect_equal(.bp_veto_reason(0.9, 0.05),
+    paste("min_cluster_stability 0.05 < 0.2",
+      "avg + min_cluster_stability 0.95 < 1.0", sep = "; "))
+  # NA stability fails conservatively with a single reason
+  expect_equal(.bp_veto_reason(as.double(NA), 0.5),
+    "stability statistics unavailable")
+  expect_equal(.bp_veto_reason(0.9, as.double(NA)),
+    "stability statistics unavailable")
+})
+
+test_that("S1: the CV argmin passing the veto is selected", {
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(300, 240, 260, 280), c(.9, .95, .85, .82),
+      c(.35, .4, .3, .25)), 3L)
+  out <- .bp_k_arbitrate(ev, cv = TRUE, mode = "explicit")
+  expect_true(out$selected[2L])                # row for k = 3
+  expect_equal(sum(out$selected), 1L)
+})
+
+test_that("S2: a vetoed argmin falls back to the first passing rank in CV-error order", {
+  # k=3 is the argmin (cv 240) but unstable; passers k=4 (260), k=5 (280),
+  # k=2 (300) -> fallback scan on CV-error ascending picks k=4
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(300, 240, 260, 280), c(.9, .5, .85, .82),
+      c(.35, .1, .3, .25)), 3L)
+  out <- .bp_k_arbitrate(ev, cv = TRUE, mode = "explicit")
+  expect_false(out$selected[2L])
+  expect_true(out$selected[3L])
+})
+
+test_that("S3: with layer 1 switched off the lowest passing rank wins", {
+  ev <- kcore_ev(2:5, c(300, 240, 260, 280), c(.5, .5, .85, .82),
+    c(.1, .1, .3, .25))
+  out <- .bp_k_arbitrate(ev, cv = FALSE, mode = "explicit")
+  expect_false(any(out$is_argmin))             # layer 1 absent erases the column
+  expect_true(out$selected[3L])                # k=4, the lowest passing rank
+})
+
+test_that("S4: no rank passing raises in the explicit mode", {
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(300, 240, 260, 280), rep(.4, 4), rep(.1, 4)), 3L)
+  expect_error(.bp_k_arbitrate(ev, cv = TRUE, mode = "explicit"),
+    "undecidable")
+})
+
+test_that("S5: no rank passing degrades to the argmin with a warning in pipeline mode", {
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(300, 240, 260, 280), rep(.4, 4), rep(.1, 4)), 3L)
+  expect_warning(out <- .bp_k_arbitrate(ev, cv = TRUE, mode = "degrade"),
+    "undecidable")
+  expect_true(out$selected[2L])                # the argmin (k = 3)
+})
+
+test_that("S6: the lowest tied rank carries the argmin mark into the core", {
+  # all ranks pass -> the carried argmin (lowest of the cv tie at 240) wins
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(300, 240, 240, 280), c(.9, .95, .9, .82),
+      c(.35, .4, .35, .25)), 3L)
+  out <- .bp_k_arbitrate(ev, cv = TRUE, mode = "explicit")
+  expect_true(out$selected[2L])                # k = 3
+})
+
+test_that("S7: fallback among passers breaks CV ties by the lower rank", {
+  # argmin k=2 (240) vetoed; passers k=3 (240), k=4 (260), k=5 (280);
+  # the scan takes k=3 first
+  ev <- kcore_set_argmin(
+    kcore_ev(2:5, c(240, 240, 260, 280), c(.4, .95, .9, .82),
+      c(.1, .4, .35, .25)), 2L)
+  out <- .bp_k_arbitrate(ev, cv = TRUE, mode = "explicit")
+  expect_true(out$selected[2L])                # k = 3
+  # vetoing k=3 leaves passers k=4 and k=5 tied at 260 -> the scan takes
+  # the lower rank k=4
+  ev2 <- kcore_set_argmin(
+    kcore_ev(2:5, c(240, 240, 260, 260), c(.4, .4, .9, .85),
+      c(.1, .4, .35, .3)), 2L)
+  out2 <- .bp_k_arbitrate(ev2, cv = TRUE, mode = "explicit")
+  expect_true(out2$selected[3L])               # k = 4
+})
+
+test_that("the argmin mark is computed on finite CV values only, lowest rank on ties", {
+  # survey layer fills is_argmin; port law: among finite cv entries the
+  # first minimum (which.min = lowest rank on ties); all-NA curve -> none
+  expect_equal(.bp_cv_argmin(c(300, 240, 240, 280)), 2L)
+  expect_equal(.bp_cv_argmin(rep(as.double(NA), 4)), integer(0))
+  expect_equal(.bp_cv_argmin(c(as.double(NA), 240, 100, 280)), 3L)
+  expect_equal(.bp_cv_argmin(c(240, as.double(NA), 240, 280)), 1L)
+})
+
+test_that("input validation fails fast with named messages", {
+  good <- kcore_ev(2:3, c(300, 240), c(.9, .9), c(.3, .3))
+  expect_error(.bp_k_arbitrate(as.data.frame(list(k = 1)), cv = TRUE,
+    mode = "explicit"), "column")
+  expect_error(.bp_k_arbitrate(transform(good, k = c(3L, 2L)), cv = TRUE,
+    mode = "explicit"), "increasing")
+  expect_error(.bp_k_arbitrate(transform(good, k = c(2L, 2L)), cv = TRUE,
+    mode = "explicit"), "unique")
+  expect_error(.bp_k_arbitrate(good, cv = NA, mode = "explicit"), "cv")
+  expect_error(.bp_k_arbitrate(good, cv = TRUE, mode = "wat"), "should be one of")
+  expect_error(.bp_k_arbitrate(transform(good, passes_veto = c("yes", "no")),
+    cv = TRUE, mode = "explicit"), "column")
+  # at most one row may carry the layer-1 argmin mark
+  expect_error(.bp_k_arbitrate(transform(good, is_argmin = c(TRUE, TRUE)),
+    cv = TRUE, mode = "explicit"), "argmin")
+})
diff --git a/tests/testthat/test-bp-k-arbitration-pipeline.R b/tests/testthat/test-bp-k-arbitration-pipeline.R
new file mode 100644
index 00000000..7d13a28e
--- /dev/null
+++ b/tests/testthat/test-bp-k-arbitration-pipeline.R
@@ -0,0 +1,201 @@
+# Pipeline-level acceptance units for the ported K-arbitration (parity plan
+# P2): bp_select_k() -- the CV-survey + three-layer arbitration over a rank
+# grid -- and its opt-in hookup into the bp extraction route.
+#
+# Load-bearing parity evidence: the expected verdicts are the committed
+# msuiter reference captures fixtures/bp-k-arb/msuiter_verdicts.rds
+# (produced on the controller host by the committed generator; provenance
+# header there). The calibration cells themselves are rebuilt on the fly
+# from the committed pure builder synthetic_cells.R under the pinned root
+# seed, so tested cells and recorded cells are the same numbers by
+# construction. Everything is SYNTHETIC (D3).
+
+# ---- fixture plumbing -------------------------------------------------------
+
+karb_cells_env <- new.env()
+source(file.path(test_path(), "fixtures", "bp-k-arb", "synthetic_cells.R"),
+  local = karb_cells_env)
+
+karb_verdict_capture <- function() {
+  cap <- readRDS(file.path(test_path(), "fixtures", "bp-k-arb",
+    "msuiter_verdicts.rds"))
+  # Boundary validation of the consumed capture (input-validation law).
+  if (!is.list(cap) || !all(c("root_seed", "k_grid", "cells") %in% names(cap))) {
+    stop("verdict capture must carry root_seed, k_grid and cells", domain = NA)
+  }
+  for (nm in names(cap$cells)) {
+    cl <- cap$cells[[nm]]
+    if (!all(c("name", "planted_k", "k", "dim", "evidence") %in% names(cl))) {
+      stop(sprintf("verdict cell `%s` is missing recorded fields", nm),
+        domain = NA)
+    }
+    if (!is.data.frame(cl$evidence) || nrow(cl$evidence) != length(cap$k_grid)) {
+      stop(sprintf("verdict cell `%s` carries an invalid evidence table", nm),
+        domain = NA)
+    }
+  }
+  cap
+}
+
+# ---- T1: K-agreement with the committed reference verdicts -----------------
+
+test_that("bp_select_k reaches the committed msuiter verdict on every tier", {
+  cap <- karb_verdict_capture()
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  expect_equal(vapply(cells, function(cl) cl$name, character(1L)),
+    names(cap$cells))
+  for (cl in cells) {
+    expect_equal(dim(cl$counts), cap$cells[[cl$name]]$dim, info = cl$name)
+    res <- bp_select_k(cl$counts, k_grid = cap$k_grid,
+      seed = cap$root_seed)
+    expect_equal(res$k, cap$cells[[cl$name]]$k, info = cl$name)
+    expect_equal(res$k, cl$planted_k, info = cl$name)
+    ev <- res$k_evidence
+    expect_equal(ev$k, as.integer(cap$k_grid), info = cl$name)
+    expect_equal(sum(ev$selected), 1L, info = cl$name)
+    sel <- ev[ev$selected, ]
+    expect_true(sel$passes_veto, info = cl$name)
+    expect_false(anyNA(ev$cv_test_deviance), info = cl$name)
+    expect_false(anyNA(ev$passes_veto), info = cl$name)
+  }
+})
+
+# ---- T2: single-root-seed law ----------------------------------------------
+
+test_that("one root seed yields byte-identical verdicts and diagnostics", {
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  cl <- cells[[2L]]
+  a <- bp_select_k(cl$counts, k_grid = 2:5, seed = 20261015L)
+  b <- bp_select_k(cl$counts, k_grid = 2:5, seed = 20261015L)
+  expect_equal(a$k, b$k)
+  expect_identical(serialize(a$k_evidence, connection = NULL),
+    serialize(b$k_evidence, connection = NULL))
+  # A different root seed is a different stream: the diagnostics must
+  # actually move (no frozen pseudoreplication); the decision columns stay
+  # well-formed for any stream.
+  d <- bp_select_k(cl$counts, k_grid = 2:5, seed = 99991L)
+  expect_false(identical(serialize(a$k_evidence, connection = NULL),
+    serialize(d$k_evidence, connection = NULL)))
+  expect_equal(sum(d$k_evidence$selected), 1L)
+})
+
+# ---- T3: a sabotaged stability at the argmin flips the verdict -------------
+
+test_that("an unstable CV argmin flips K to the best passing rank", {
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  cl <- cells[[3L]]                             # planted tier K = 4
+  honest <- bp_select_k(cl$counts, k_grid = 2:5, seed = 20261015L)
+  expect_equal(honest$k, 4L)                   # argmin lands on the planted tier
+
+  real_stability <- get(".bp_ensemble_stability", envir = asNamespace(
+    "sigminer"))
+  ns <- asNamespace("sigminer")
+  unlockBinding(".bp_ensemble_stability", ns)
+  on.exit({
+    assign(".bp_ensemble_stability", real_stability, envir = ns)
+    lockBinding(".bp_ensemble_stability", ns)
+  }, add = TRUE)
+  assign(".bp_ensemble_stability", function(counts, k, replicates, seed) {
+    if (identical(as.integer(k), 4L)) {
+      # the argmin rank is declared unstable, exactly the S2 shape
+      list(avg = 0.3, min = 0.05, per_signature = c(0.3, 0.05))
+    } else {
+      real_stability(counts, k, replicates, seed)
+    }
+  }, envir = ns)
+
+  flipped <- bp_select_k(cl$counts, k_grid = 2:5, seed = 20261015L)
+  ev <- flipped$k_evidence
+  expect_false(identical(flipped$k, 4L))
+  sel <- ev[ev$selected, ]
+  expect_true(sel$passes_veto)
+  expect_false(sel$is_argmin)                  # not the (vetoed) argmin row
+  # and it is the best passing rank in CV order (fallback-scan semantics)
+  cand <- ev[ev$passes_veto & !ev$is_argmin, ]
+  ord <- order(cand$cv_test_deviance, cand$k, na.last = TRUE)
+  expect_equal(flipped$k, cand$k[ord[1L]])
+})
+
+# ---- T4: diagnostics are observable on the returned object ------------------
+
+test_that("the returned evidence table carries the full diagnostic schema", {
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  res <- bp_select_k(cells[[1L]]$counts, k_grid = 2:5, seed = 20261015L)
+  ev <- res$k_evidence
+  want <- c("k", "cv_test_deviance", "cv_test_mse", "cv_train_mse",
+    "fold_test_deviance", "n_seeds_converged", "avg_stability",
+    "min_cluster_stability", "per_signature_stability",
+    "wilcoxon_p_vs_prev", "wilcoxon_l2_median_delta", "passes_veto",
+    "is_argmin", "selected", "veto_reason")
+  expect_equal(names(ev), want)
+  expect_type(ev$veto_reason, "character")
+  expect_type(ev$selected, "logical")
+  expect_true(is.list(ev$fold_test_deviance))
+  expect_equal(vapply(ev$fold_test_deviance, length, integer(1L)),
+    rep(8L, 4L))
+  expect_true(is.list(ev$per_signature_stability))
+})
+
+# ---- T5: cv = FALSE demotes to the veto-only scan ----------------------------
+
+test_that("cv = FALSE arbitrates on the stability veto alone", {
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  res <- bp_select_k(cells[[1L]]$counts, k_grid = 2:5, cv = FALSE,
+    seed = 20261015L)
+  ev <- res$k_evidence
+  expect_false(any(ev$is_argmin))              # layer 1 absent -> mark erased
+  expect_true(all(is.na(ev$cv_test_deviance))) # CV columns demoted to NA
+  fold_ok <- vapply(ev$fold_test_deviance, function(z) {
+    length(z) == 8L && all(is.na(z))
+  }, logical(1L))
+  expect_true(all(fold_ok))
+  cand <- ev[ev$passes_veto, ]
+  expect_true(nrow(cand) > 0L)
+  expect_equal(res$k, min(cand$k))             # lowest passing rank wins
+})
+
+# ---- T6: input validation fails fast at the boundary ------------------------
+
+test_that("bp_select_k validates its inputs with named messages", {
+  good <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)[[1L]]$counts
+  expect_error(bp_select_k(matrix(1:4, 2), k_grid = 2:3, seed = 1L),
+    "numeric matrix")
+  bad <- good
+  bad[1L, 1L] <- -1
+  expect_error(bp_select_k(bad, k_grid = 2:3, seed = 1L), "non-negative")
+  expect_error(bp_select_k(good, k_grid = c(2L, 0L), seed = 1L),
+    "positive whole numbers")
+  expect_error(bp_select_k(good, k_grid = 2:100L, seed = 1L),
+    "must not exceed")
+  expect_error(bp_select_k(good, k_grid = 2:3, seed = 1L, cv = NA),
+    "single TRUE or FALSE")
+  expect_error(bp_select_k(good, k_grid = 2:3, seed = 1.5), "whole number")
+  expect_error(bp_select_k(good, k_grid = 2:3, seed = 1L, replicates = 1L),
+    "replicates")
+  expect_error(bp_select_k(good, k_grid = 2:3, seed = 1L, k_folds = 200L),
+    "channel count")
+})
+
+# ---- T7: opt-in hook on the bp route, legacy preserved ---------------------
+
+test_that("k_select = 'arbitrate' annotates the route; the default is untouched", {
+  cells <- karb_cells_env$cal_cells(karb_cells_env$CAL_ROOT_SEED)
+  nmf_matrix <- t(cells[[2L]]$counts)         # samples x components for the route
+  legacy <- bp_extract_signatures(nmf_matrix, range = 2:3, n_bootstrap = 0L,
+    n_nmf_run = 2L, cores = 1L, cores_solution = 1L, seed = 123456L)
+  arbit <- bp_extract_signatures(nmf_matrix, range = 2:3, n_bootstrap = 0L,
+    n_nmf_run = 2L, cores = 1L, cores_solution = 1L, seed = 123456L,
+    k_select = "arbitrate")
+  # Legacy preservation: every slot the legacy result has (except the
+  # intentionally re-arbitrated `suggested`) is byte-identical.
+  for (slot in setdiff(names(legacy), "suggested")) {
+    expect_identical(serialize(legacy[[slot]], connection = NULL),
+      serialize(arbit[[slot]], connection = NULL), info = slot)
+  }
+  expect_equal(arbit$suggested_legacy, legacy$suggested)
+  expect_type(arbit$suggested, "integer")
+  ev <- arbit$k_evidence
+  expect_true(is.data.frame(ev))
+  expect_equal(ev$k[ev$selected], arbit$suggested)
+  expect_true(any(ev$selected))
+})
diff --git a/tests/testthat/test-bp-k-arbitration-replay.R b/tests/testthat/test-bp-k-arbitration-replay.R
new file mode 100644
index 00000000..8239af1e
--- /dev/null
+++ b/tests/testthat/test-bp-k-arbitration-replay.R
@@ -0,0 +1,94 @@
+# Fixture replay for the bp K-arbitration core (parity plan P2).
+#
+# Consumes the committed reference capture
+# fixtures/bp-k-arb/msuiter_core_cases.rds: seven hand-built evidence
+# frames (S1..S7 of the parity design) run through the msuiter reference
+# core (.ms_k_arbitrate, msuiter main@dad30440) on the controller host,
+# recorded with their run parameters. Replaying them here asserts the
+# ported core takes the identical decision on every recorded frame.
+#
+# The unit is msuiter-absent-safe: the .rds payload is plain data (data
+# frames, scalars, NULL), loaded with readRDS only. The provenance
+# generator next to the fixture re-produces both .rds files verbatim on
+# the controller host; it is never sourced by R CMD check.
+
+karb_fixture_path <- function(... ) {
+  file.path(test_path(), "fixtures", "bp-k-arb", ...)
+}
+
+# Boundary validation of the consumed capture (input-validation law): a
+# silently corrupt fixture must fail loudly here, not skew the replay.
+validate_core_capture <- function(capture) {
+  if (!is.list(capture) || !all(c("root_seed", "cases") %in% names(capture))) {
+    stop("core capture must carry `root_seed` and `cases`", domain = NA)
+  }
+  for (nm in names(capture$cases)) {
+    cs <- capture$cases[[nm]]
+    need <- c("ev", "cv", "mode", "expect_error", "warned")
+    if (!all(need %in% names(cs))) {
+      stop(sprintf("core case `%s` is missing recorded field(s): %s", nm,
+        paste0(dQuote(setdiff(need, names(cs))), collapse = ", ")),
+        domain = NA)
+    }
+    if (!is.data.frame(cs$ev) ||
+        !all(.BP_K_EVIDENCE_REQUIRED %in% names(cs$ev))) {
+      stop(sprintf("core case `%s` carries an invalid evidence frame", nm),
+        domain = NA)
+    }
+    if (!identical(cs$mode, "explicit") && !identical(cs$mode, "degrade")) {
+      stop(sprintf("core case `%s` records an unknown mode", nm), domain = NA)
+    }
+    if (!isTRUE(cs$expect_error) && !isFALSE(cs$expect_error)) {
+      stop(sprintf("core case `%s` has no recorded error outcome", nm),
+        domain = NA)
+    }
+  }
+  capture
+}
+
+capture <- validate_core_capture(readRDS(karb_fixture_path(
+  "msuiter_core_cases.rds")))
+
+test_that("the reference capture is the recorded seven-scenario battery", {
+  expect_equal(capture$root_seed, 20261015L)
+  expect_equal(names(capture$cases),
+    c("S1_argmin_passes", "S2_argmin_vetoed_fallback",
+      "S3_cv_off_lowest_passing", "S4_none_passes_explicit_error",
+      "S5_none_passes_degrade_to_argmin", "S6_cv_tie_lowest_rank",
+      "S7_vetoed_argmin_tie_fallback"))
+})
+
+test_that("every recorded core case replays to the identical reference decision", {
+  for (nm in names(capture$cases)) {
+    cs <- capture$cases[[nm]]
+    if (cs$expect_error) {
+      # layer-3 parity: the reference errored; the port must too, in the
+      # explicit mode, with the undecidable diagnosis.
+      expect_error(.bp_k_arbitrate(cs$ev, cv = cs$cv, mode = cs$mode),
+        "undecidable", info = nm)
+      next
+    }
+    if (cs$warned) {
+      expect_warning(out <- .bp_k_arbitrate(cs$ev, cv = cs$cv,
+        mode = cs$mode), "undecidable", info = nm)
+    } else {
+      out <- .bp_k_arbitrate(cs$ev, cv = cs$cv, mode = cs$mode)
+    }
+    expect_equal(out$selected, cs$selected, info = nm)
+    expect_equal(out$is_argmin, cs$is_argmin_out, info = nm)
+    expect_equal(sum(out$selected), 1L, info = nm)
+  }
+})
+
+test_that("the replayed decisions are stable across repeated invocations", {
+  # determinism cross-check: the core is a pure function, so two
+  # invocations per case must agree bit-for-bit through serialization.
+  for (nm in names(capture$cases)) {
+    cs <- capture$cases[[nm]]
+    if (cs$expect_error) next
+    a <- suppressWarnings(.bp_k_arbitrate(cs$ev, cv = cs$cv, mode = cs$mode))
+    b <- suppressWarnings(.bp_k_arbitrate(cs$ev, cv = cs$cv, mode = cs$mode))
+    expect_equal(serialize(a, connection = NULL),
+      serialize(b, connection = NULL), info = nm)
+  }
+})
