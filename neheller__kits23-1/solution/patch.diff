+        for i in sorting:
+            f.write('%s,%d,%.4f,%.8f,%.8f,%.8f\n' % (teams[i], ranks[i], aggregated[i], mean_dice[i], mean_sd[i],
+                                                     metrics[i, 2]))
+
+
+if __name__ == '__main__':
+    summary_file = 'summary.csv'  # follow the example csv provided in this folder!
+    output_file = 'kits2023_ranking.csv'
