+#' @title Bulk RNA-seq deconvolution with a (matched or external) scRNAseq reference
+#' @description Deconvolve bulk RNA-seq samples against a single-cell reference
+#'   using the matched-scRNAseq pipeline. Each bulk sample is treated as an
+#'   independent mixture and solved jointly via hierarchical constrained NNLS
+#'   against the reference. Algorithmic semantics are identical to
+#'   \code{SpaCET.deconvolution.matched.scRNAseq} with
+#'   \code{sc_includeMalignant=TRUE}: no malignant-first CNA cascade, no
+#'   within-cohort purity rescaling, malignant cells deconvolved jointly with
+#'   non-malignant types when present in the reference.
+#' @param counts Bulk count matrix with gene name (row) x sample ID (column).
+#'   Raw counts are expected (the function applies its own normalization
+#'   internally, the same as the spatial pipeline).
+#' @param sc_counts Single cell count matrix with gene name (row) x cell ID
+#'   (column).
+#' @param sc_annotation Single cell annotation matrix. Must include two
+#'   columns named \code{cellID} and \code{cellType}. Each row represents a
+#'   single cell.
+#' @param sc_lineageTree Cell lineage tree. A named list whose names are major
+#'   lineages and whose values are vectors of sub-lineages. If a major lineage
+#'   has no sub-lineages, the value should be the major lineage name itself.
+#' @param sc_downsampling Whether to downsample the single-cell data per cell
+#'   type before building the reference. Default: TRUE.
+#' @param sc_nCellEachLineage Cell count per lineage when downsampling.
+#'   Default: 100. If a cell type has more than this many cells, that many are
+#'   randomly selected (with seed 123) to build the reference.
+#' @param coreNo Core number for parallel reference construction.
+#' @return A SpaCET object whose \code{@results$deconvolution$propMat} slot
+#'   holds the cell-type proportion matrix (cell types x samples). The object
+#'   has placeholder spatial coordinates and a \code{platform = "Bulk"} flag,
+#'   so visualization functions that depend on real coordinates should not be
+#'   used; downstream summarization should access \code{propMat} directly.
+#' @details
+#'   This function targets the unmatched-bulk use case (e.g. TCGA cohorts
+#'   deconvolved against an external scRNAseq atlas). The reference does not
+#'   need to come from the same patients as the bulk samples — what matters is
+#'   that it covers all relevant cell types at sufficient resolution. When
+#'   reference and bulk come from different cohorts, set
+#'   \code{sc_downsampling=TRUE} (default) and consider seeding the reference
+#'   with a sub-lineage-aware lineage tree so cross-cohort variability does
+#'   not collapse onto a single major-type signature.
+#'
+#'   This function intentionally exposes only the matched-scRNAseq path
+#'   (\code{sc_includeMalignant=TRUE}) and does not call the malignant-first
+#'   CNA cascade used by \code{SpaCET.deconvolution} for spatial spots. The
+#'   per-sample CNA cascade is designed for the spot-scale (1-100 cells per
+#'   spot) and is not appropriate for bulk RNA-seq, where each sample
+#'   aggregates over millions of cells.
+#' @examples
+#' \dontrun{
+#' # Bulk count matrix: genes x samples (e.g. TCGA-BRCA)
+#' bulk_counts <- ...
+#'
+#' # scRNAseq reference (e.g. Wu et al. 2021 BRCA atlas)
+#' sc_counts <- ...        # genes x cells
+#' sc_annotation <- ...    # cellID, cellType
+#' lineageTree <- list(
+#'   "Malignant" = "Malignant",
+#'   "T cell"    = c("T CD4", "T CD8"),
+#'   "Myeloid"   = c("Macrophage", "DC", "Monocyte"),
+#'   "B cell"    = "B cell",
+#'   "CAF"       = "CAF",
+#'   "Endothelial" = "Endothelial"
+#' )
+#'
+#' SpaCET_obj <- SpaCET.deconvolution.bulk.matched.scRNAseq(
+#'   counts        = bulk_counts,
+#'   sc_counts     = sc_counts,
+#'   sc_annotation = sc_annotation,
+#'   sc_lineageTree = lineageTree
+#' )
+#'
+#' propMat <- SpaCET_obj@results$deconvolution$propMat
+#' }
+#'
+#' @rdname SpaCET.deconvolution.bulk.matched.scRNAseq
+#' @export
+SpaCET.deconvolution.bulk.matched.scRNAseq <- function(
+  counts,
+  sc_counts,
+  sc_annotation,
+  sc_lineageTree,
+  sc_downsampling = TRUE,
+  sc_nCellEachLineage = 100,
+  coreNo = 6
+)
+{
+  if(is.null(rownames(counts)))
+  {
+    stop("`counts` must have gene names as rownames.")
+  }
+  if(is.null(colnames(counts)))
+  {
+    stop("`counts` must have sample IDs as colnames.")
+  }
+  if(any(duplicated(colnames(counts))))
+  {
+    stop("`counts` has duplicated sample IDs in colnames.")
+  }
+
+  counts <- methods::as(methods::as(counts, "matrix"), "CsparseMatrix")
+
+  # Placeholder coordinates so the SpaCET object validates. Bulk samples are
+  # not spatially organized; these coordinates are not used by the
+  # matched.scRNAseq deconvolution path.
+  spotCoordinates <- data.frame(
+    row.names = colnames(counts),
+    pixel_row = seq_len(ncol(counts)),
+    pixel_col = rep(1, ncol(counts))
+  )
+
+  SpaCET_obj <- methods::new(
+    "SpaCET",
+    input = list(
+      counts = counts,
+      spotCoordinates = spotCoordinates,
+      metaData = NULL,
+      image = list(path = NA, grob = NA),
+      platform = "Bulk",
+      organism = "human"
+    )
+  )
+
+  SpaCET.deconvolution.matched.scRNAseq(
+    SpaCET_obj,
+    sc_includeMalignant = TRUE,
+    sc_counts = sc_counts,
+    sc_annotation = sc_annotation,
+    sc_lineageTree = sc_lineageTree,
+    sc_downsampling = sc_downsampling,
+    sc_nCellEachLineage = sc_nCellEachLineage,
+    coreNo = coreNo
+  )
+}
+
+
 generateRef <- function(
