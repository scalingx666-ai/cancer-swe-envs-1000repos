+   "outputs": [],
+   "source": [
+    "# Load model and tokenizer from Hugging Face\n",
+    "config = AutoConfig.from_pretrained(\n",
+    "    \"InstaDeepAI/BulkRNABert\",\n",
+    "    trust_remote_code=True,\n",
+    ")\n",
