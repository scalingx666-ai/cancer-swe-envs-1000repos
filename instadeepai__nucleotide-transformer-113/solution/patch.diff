+   "outputs": [],
+   "source": [
+    "from huggingface_hub import hf_hub_download\n",
+    "import numpy as np\n",
+    "import pandas as pd\n",
+    "from transformers import AutoConfig, AutoModel, AutoTokenizer"
+   ]
