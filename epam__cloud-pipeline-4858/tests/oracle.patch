+    (('sub1//sub2/folder/',), 'sub1/sub2/'),
+    (('sub1/./sub2/folder/',), 'sub1/sub2/'),
+    (('sub1/sub2/other/../folder/',), 'sub1/sub2/'),
+    # `..` as the item itself: the path names `sub1`, so the selection is that folder and nothing
