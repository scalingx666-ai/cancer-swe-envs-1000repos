+      "cell_type": "code",
+      "execution_count": null,
+      "metadata": {},
+      "outputs": [],
+      "source": [
+        "# Define tracks to plot (track_name -> track_id)\n",
+        "tracks_to_plot = {\n",
+        "    \"K562 RNA-seq\": \"ENCSR056HPM\",\n",
+        "    \"K562 DNAse\": \"ENCSR921NMD\",\n",
