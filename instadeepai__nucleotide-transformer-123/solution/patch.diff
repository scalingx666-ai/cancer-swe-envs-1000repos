+      "source": [
+        "# Example DNA sequences (padded to 256 nucleotides for demo)\n",
+        "# generate 2 random ATCG string length 2**15\n",
+        "import random\n",
+        "sequences = [\n",
+        "    \"\".join(random.choices(\"ATCG\", k=2**15)),\n",
