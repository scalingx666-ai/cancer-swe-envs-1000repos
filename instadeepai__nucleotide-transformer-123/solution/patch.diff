+      "source": [
+        "def plot_tracks(tracks, start, end, chrom, assembly, height=1.0):\n",
+        "    \"\"\"Plot functional genomics tracks.\"\"\"\n",
+        "    fig, axes = plt.subplots(len(tracks), 1, figsize=(20, height * len(tracks)), sharex=True)\n",
