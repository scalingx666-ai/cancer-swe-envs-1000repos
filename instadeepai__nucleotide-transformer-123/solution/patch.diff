+    ):
+        super().__init__(
+            dim_in=dim_in, dim_out=dim_out, upsample_type=upsample_type, rngs=rngs
+        )
+        self.conv = AdaptiveDeConvBlock(
+            dim=dim_in,
+            dim_out=dim_out,
+            kernel_size=5,
+            upsample=upsample_type,
+            conditions_dims=conditions_dims,
+            dtype=dtype,
+            param_dtype=param_dtype,
+            ln_dtype=ln_dtype,
