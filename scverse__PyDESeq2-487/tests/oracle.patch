-   The bright green is not readable as text on white, so a darker "ink" variant carries text and links while the saturated original stays decorative.
-   The theme (scanpydoc on top of sphinx-book-theme / pydata-sphinx-theme) is steered through its CSS custom properties.
-   ========================================================================= */
-
-/* -- Brand palette --------------------------------------------------------- */
-:root {
-    --pydeseq2-green: #2cb446;
-    --pydeseq2-green-ink: #078013;
-    --pydeseq2-green-light: #6fd685;
-    --pydeseq2-green-tint: #eaf8ed;
-    --pydeseq2-forest: #05500d;
-    --pydeseq2-slate: #2f3a33;
-    --pydeseq2-cream: #f4f8f5;
-}
-
-/* -- Light mode ------------------------------------------------------------ */
-html[data-theme="light"] {
-    --pst-color-primary: var(--pydeseq2-green-ink);
-    --pst-color-primary-highlight: var(--pydeseq2-forest);
-    --pst-color-secondary: var(--pydeseq2-slate);
-    --pst-color-secondary-highlight: var(--pydeseq2-forest);
-    --pst-color-link: var(--pydeseq2-green-ink);
-    --pst-color-link-hover: var(--pydeseq2-forest);
-    --pst-color-inline-code: var(--pydeseq2-green-ink);
-    --pst-color-accent: var(--pydeseq2-green);
-    --pst-color-target: var(--pydeseq2-green-tint);
-
-    --sd-color-primary: var(--pydeseq2-green-ink);
-    --sd-color-primary-highlight: var(--pydeseq2-forest);
-    --sd-color-shadow: rgb(47 58 51 / 18%);
-}
-
-/* -- Dark mode ------------------------------------------------------------- */
-html[data-theme="dark"] {
-    /* The saturated logo green only has enough contrast on a dark background. */
