-    --pst-color-secondary: var(--pydeseq2-green-light);
-    --pst-color-secondary-highlight: var(--pydeseq2-cream);
-    --pst-color-link: var(--pydeseq2-green-light);
-    --pst-color-link-hover: var(--pydeseq2-green);
