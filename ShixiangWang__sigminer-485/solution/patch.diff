diff --git a/tests/testthat/helper-refit-synthetic.R b/tests/testthat/helper-refit-synthetic.R
new file mode 100644
index 00000000..26292ef6
--- /dev/null
+++ b/tests/testthat/helper-refit-synthetic.R
@@ -0,0 +1,100 @@
+## ---------------------------------------------------------------------------
+## Shared synthetic fixtures for the P3 refit-method test family
+## (method = "likelihood" / "lrt", added by the P3 refit lane).
+##
+## D3 law: every numeric here is hand-built. Nothing in this family derives
+## from COSMIC or any other real reference distribution.
+## ---------------------------------------------------------------------------
+
+## Six hand-built reference signatures over a 30-component grid:
+##   A, B, C  spike-like, clearly distinct supports
+##   D        perfectly flat (uniform)
+##   E        near-flat (mild monotone tilt, still close to uniform)
+##   F        decoy spike on its own component
+p3_refit_sig <- function() {
+  W <- matrix(0, nrow = 30, ncol = 6)
+  dimnames(W) <- list(paste0("c", 1:30), c("A", "B", "C", "D", "E", "F"))
+  W["c1", "A"] <- .80; W[c("c2", "c3", "c4", "c5"), "A"] <- .05
+  W["c10", "B"] <- .80; W[c("c6", "c7", "c8", "c9"), "B"] <- .05
+  W["c20", "C"] <- .75; W[c("c15", "c16", "c17", "c18", "c19"), "C"] <- .05
+  W[, "D"] <- 1 / 30
+  ## Near-flat shape column: a mild global tilt (the hand-built analogue of
+  ## the documented flat-signature family, cf. docs/research/
+  ## 00-executive-summary.md:30). Carries real structure so its presence is
+  ## statistically detectable, while a uniform+tilt mix remains only
+  ## pair-sufficient (measured in /tmp/p3refit/logs/03b-nullcal-probe.log).
+  tilt <- 1 + .45 * ((1:30) - 15.5) / 15.5
+  W[, "E"] <- tilt / sum(tilt)
+  W["c28", "F"] <- .55; W[paste0("c", 21:27), "F"] <- .45 / 7
+  W / apply(W, 2, sum)
+}
+
+## Deterministic integer catalog: expected reconstruction W %*% e scaled to a
+## fixed total and rounded, with the rounding residual parked on the largest
+## cell so the column sum is exact. No RNG involved.
+p3_refit_catalog <- function(weights, total = 1000L, sample_name = "smp") {
+  W <- p3_refit_sig()
+  e <- rep(0, ncol(W))
+  names(e) <- colnames(W)
+  e[names(weights)] <- as.numeric(weights)
+  mu <- as.numeric(W %*% e) * total
+  d <- round(mu)
+  j <- which.max(d)
+  d[j] <- d[j] + (total - sum(d))
+  out <- matrix(as.integer(d), ncol = 1L)
+  dimnames(out) <- list(rownames(W), sample_name)
+  out
+}
+
+## Draw one null spectrum from a featureless uniform background. This is the
+## null-derived fixture shape for the presence-calibration family: it carries
+## no signature structure, so any declaration of a reference column by a
+## selection-based method is a genuine false positive (the hard FP cases are
+## the flat-like columns D/E, cf. the documented flat-signature failure mode
+## in docs/research/00-executive-summary.md:30).
+p3_refit_null_draw <- function(total = 1000L, sample_name = "null") {
+  d <- as.integer(rmultinom(1L, total, prob = rep(1 / 30, 30)))
+  out <- matrix(d, ncol = 1L)
+  dimnames(out) <- list(rownames(p3_refit_sig()), sample_name)
+  out
+}
+
+## Count vector for which a signature counts as "declared" in the judgment
+## window of the null-calibration family (a-priori, documented in the test).
+p3_declare_threshold <- 0.01
+
+## Column-wise share matrix (each sample's exposures over its own total; an
+## all-zero sample stays all-zero).
+p3_normalize <- function(e) {
+  cs <- apply(e, 2L, sum)
+  cs[cs == 0] <- 1
+  e / rep(cs, each = nrow(e))
+}
+
+## Shared method-argument contract for both new refit methods: choices must
+## resolve through the house match.arg idiom (case-sensitive exact or
+## unique-prefix), and a refusal must enumerate every valid choice.
+p3_check_method_argument <- function(catalog, W, exact, partial) {
+  expect_silent(suppressMessages(
+    sig_fit(catalog, sig = W, method = exact)
+  ))
+  expect_silent(suppressMessages(
+    sig_fit(catalog, sig = W, method = partial)
+  ))
+  ## Ambiguous prefix ("l" for both new choices) must be refused, naming both.
+  err_amb <- tryCatch({
+    suppressMessages(sig_fit(catalog, sig = W, method = "l")); "no-error"
+  }, error = function(e) conditionMessage(e))
+  expect_match(err_amb, "likelihood")
+  expect_match(err_amb, "lrt")
+  ## Case sensitivity: an unmatched case variant errors, listing all choices.
+  err_case <- tryCatch({
+    suppressMessages(sig_fit(catalog, sig = W, method = "L")); "no-error"
+  }, error = function(e) conditionMessage(e))
+  expect_match(err_case, "QP")
+  expect_match(err_case, "NNLS")
+  expect_match(err_case, "SA")
+  expect_match(err_case, "likelihood")
+  expect_match(err_case, "lrt")
+}
+
diff --git a/tests/testthat/test-sig-fit-refit-bootstrap-par.R b/tests/testthat/test-sig-fit-refit-bootstrap-par.R
new file mode 100644
index 00000000..d16b12b4
--- /dev/null
+++ b/tests/testthat/test-sig-fit-refit-bootstrap-par.R
@@ -0,0 +1,197 @@
+## Parallel bootstrap route for the refit judgment (sig_fit_bootstrap /
+## sig_fit_bootstrap_batch territory, parity plan P3). The two new methods
+## must flow through the existing bootstrap surfaces, whose replicate/sample
+## fan-out rides the house future/furrr route (R/utils.R:37
+## set_future_strategy), with the judgment -- which signatures survive --
+## evaluated per replicate.
+
+test_that("sig_fit_bootstrap accepts the two new methods end-to-end", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5), total = 500L)
+  for (method in c("likelihood", "lrt")) {
+    hb <- suppressMessages(suppressWarnings(
+      sig_fit_bootstrap(catalog, sig = W, n = 6L, method = method,
+        type = "absolute"
+      )
+    ))
+    expect_true(is.list(hb), info = method)
+    expect_true(all(c("expo", "errors", "cosine") %in% names(hb)), info = method)
+    expect_equal(dimnames(hb$expo)[[2]], paste0("Rep_", 1:6), info = method)
+    expect_equal(rownames(hb$expo), colnames(W), info = method)
+    expect_equal(length(hb$errors), 6L, info = method)
+    expect_equal(length(hb$cosine), 6L, info = method)
+    ## The judgment must hold across resampling: A and B dominate every
+    ## replicate of this well-populated cell.
+    rel <- p3_normalize(hb$expo)
+    expect_true(all(rel["A", ] > .2 & rel["B", ] > .2), info = method)
+    expect_true(all(rel[c("C", "D", "E", "F"), ] < p3_declare_threshold),
+      info = paste(method, "bootstrap noise leak"))
+  }
+})
+
+test_that("bootstrap method choices follow the same match.arg contract", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5), total = 500L)
+  err <- tryCatch({
+    suppressMessages(sig_fit_bootstrap(catalog, sig = W, n = 1L, method = "l"))
+    "no-error"
+  }, error = function(e) conditionMessage(e))
+  expect_match(err, "likelihood")
+  expect_match(err, "lrt")
+})
+
+test_that("batch route runs both new methods and passes refit arguments through", {
+  W <- p3_refit_sig()
+  samples <- list(
+    p3_refit_catalog(c(A = .5, B = .5), total = 500L, sample_name = "s1"),
+    p3_refit_catalog(c(C = 1), total = 500L, sample_name = "s2"),
+    p3_refit_catalog(c(A = 1), total = 500L, sample_name = "s3")
+  )
+  ## The batch route maps samples over colnames(catalogue_matrix), so the
+  ## sample names come from p3_refit_catalog(sample_name = ...) directly;
+  ## they are already unique and must be preserved.
+  mats <- do.call(cbind, samples)
+  rv <- suppressMessages(suppressWarnings(
+    sig_fit_bootstrap_batch(mats, sig = W, methods = c("likelihood", "lrt"),
+      n = 4L, seed = 90210L, use_parallel = FALSE, alpha = 0.05
+    )
+  ))
+  expect_true(is.list(rv))
+  expect_true(all(c("expo", "error", "cosine", "p_val") %in% names(rv)))
+  expect_true(all(c("likelihood", "lrt") %in% rv$expo$method))
+  expect_true(all(c("s1", "s2", "s3") %in% rv$expo$sample))
+  ## The s2 cell must end up C-owned in both methods at the optimal row
+  ## (the batch tables are long-format: sample/sig/exposure/type/method).
+  ## Per-replicate judgment stability is covered through the single-sample
+  ## bootstrap surface by the first test of this file.
+  for (m in c("likelihood", "lrt")) {
+    opt <- rv$expo[type == "optimal" & sample == "s2" & method == m, ]
+    expect_gte(nrow(opt), 6L, label = paste(m, "s2 long rows"))
+    tot <- sum(opt$exposure)
+    expect_gt(opt[sig == "C", exposure] / tot, .90, label = paste(m, "s2 optimal C"))
+  }
+})
+
+## Worker-snapshot gate: future workers are fresh R processes that resolve
+## sigminer through .libPaths(), never the load_all namespace of the test
+## master. This battery therefore provisions a worker snapshot with
+##   R CMD INSTALL --no-byte-compile --library=/tmp/p3refit/rlib <tree>
+## immediately before the files run (see /tmp/p3refit/run_battery.sh); under
+## R CMD check the check library already plays this role. If neither is
+## present the arms skip loudly rather than silently passing.
+p3_worker_snapshot <- function() {
+  p3_worker_lib <- "/tmp/p3refit/rlib"
+  have_snapshot <- dir.exists(p3_worker_lib) && isTRUE(
+    "sigminer" %in% rownames(utils::installed.packages(lib.loc = p3_worker_lib,
+      no.cache = TRUE))
+  )
+  if (!have_snapshot && dir.exists(Sys.getenv("RCHECK_DIR", ""))) {
+    have_snapshot <- TRUE
+    p3_worker_lib <- .libPaths()[[1L]]
+  }
+  skip_if_not(have_snapshot,
+    paste("no worker snapshot: provision", p3_worker_lib,
+      "with R CMD INSTALL before the battery"))
+  p3_worker_lib
+}
+
+p3_batch_cell <- function() {
+  mats <- p3_refit_catalog(c(A = .5, B = .5), total = 400L)
+  mats <- cbind(mats, p3_refit_catalog(c(C = 1), total = 400L),
+    p3_refit_catalog(c(D = .3, E = .7), total = 400L))
+  colnames(mats) <- c("s1", "s2", "s3")
+  mats
+}
+
+p3_batch <- function(mats, W, par) {
+  suppressMessages(suppressWarnings(
+    sig_fit_bootstrap_batch(mats, sig = W, methods = "lrt",
+      n = 20L, seed = 42424L, use_parallel = par
+    )
+  ))
+}
+
+## Optimal rows of one payload, ordered by the key columns the payload
+## actually carries (expo/p_val are keyed by sample+sig, error/cosine by
+## method+sample+type, so a blind order(sample, sig) would break the latter).
+p3_optimal <- function(payload) {
+  if ("type" %in% colnames(payload)) {
+    payload <- payload[type == "optimal"]
+  }
+  key <- intersect(c("method", "sample", "sig"), colnames(payload))
+  ord <- do.call(order, lapply(key, function(k) payload[[k]]))
+  payload[ord, ]
+}
+
+test_that("the parallel batch route drives the refit judgment on workers", {
+  ## What the cross-arm contract is: the house route reseeds every worker
+  ## from the master L'Ecuyer counter stream (furrr_options(seed = TRUE),
+  ## R/sig_fit_bootstrap_batch.R:166), so bit-for-bit cross-arm identity of
+  ## the RNG-consumed aggregates is NOT part of the contract -- the legacy
+  ## suite pins it neither. The pins here are the real contract: workers
+  ## execute this lane's code (snapshot-provisioned) and the two arms agree
+  ## structurally, in the significance pattern, and statistically.
+  W <- p3_refit_sig()
+  p3_worker_lib <- p3_worker_snapshot()
+  mats <- p3_batch_cell()
+  serial <- p3_batch(mats, W, FALSE)
+  opaths <- .libPaths()
+  ## base::.libPaths(new) REPLACES the search path, so prepend the snapshot
+  ## in front of the retained old paths (the site libraries hold future etc.).
+  .libPaths(c(p3_worker_lib, opaths))
+  on.exit(.libPaths(opaths))
+  parallel <- p3_batch(mats, W, 2L)
+  for (nm in c("expo", "error", "cosine", "p_val")) {
+    expect_equal(colnames(serial[[nm]]), colnames(parallel[[nm]]), info = nm)
+    expect_equal(nrow(serial[[nm]]), nrow(parallel[[nm]]), info = nm)
+    expect_true(all(serial[[nm]]$method %in% "lrt"), info = nm)
+  }
+  so <- p3_optimal(serial$expo)
+  po <- p3_optimal(parallel$expo)
+  expect_equal(so$sample, po$sample)
+  expect_equal(so$sig, po$sig)
+  rel <- abs(so$exposure - po$exposure) / pmax(so$exposure, 1e-9)
+  ## Measured on this fixture at n = 20 (battery log): max relative
+  ## difference 0.0 per sample; the band is the honest no-regression room.
+  expect_lt(max(rel), .25)
+  sp <- p3_optimal(serial$p_val)
+  pp <- p3_optimal(parallel$p_val)
+  expect_equal(sp$sample, pp$sample)
+  expect_equal(sp$sig, pp$sig)
+  ## The decision layer must not fork: same significance calls in both arms
+  ## (measured: identical; the true signatures sit at ~1e-25, the rest at 1).
+  expect_equal(sp$p_value < .05, pp$p_value < .05)
+  sc <- p3_optimal(serial$cosine)
+  pc <- p3_optimal(parallel$cosine)
+  expect_equal(sc$sample, pc$sample)
+  ## Measured on this fixture (battery log): the optimal-row cosines are
+  ## 1 / 1 / NaN in BOTH arms -- the flat cell (s3) yields a deterministic
+  ## NaN optimal cosine, so the cross-arm pin is identity INCLUDING the NaN
+  ## positions (identical() treats NaN as identical to NaN), and the clean
+  ## cells (s1, s2) must reconstruct with fidelity above .99.
+  expect_identical(sc$cosine, pc$cosine)
+  expect_true(all(sc$cosine[sc$sample %in% c("s1", "s2")] > .99))
+  expect_true(all(pc$cosine[pc$sample %in% c("s1", "s2")] > .99))
+  expect_true(all(is.na(sc$cosine[sc$sample == "s3"])))
+  expect_true(all(is.na(pc$cosine[pc$sample == "s3"])))
+  expect_true(all(serial$error$errors >= 0))
+  expect_true(all(parallel$error$errors >= 0))
+})
+
+test_that("the parallel batch route is reproducible under a pinned seed", {
+  ## The rigorous half of the parallel contract: two runs of the parallel
+  ## arm at the same seed and worker count are bit-identical in all four
+  ## payloads (measured: all.equal TRUE x 4 in the battery probe).
+  W <- p3_refit_sig()
+  p3_worker_lib <- p3_worker_snapshot()
+  mats <- p3_batch_cell()
+  opaths <- .libPaths()
+  .libPaths(c(p3_worker_lib, opaths))
+  on.exit(.libPaths(opaths))
+  run1 <- p3_batch(mats, W, 2L)
+  run2 <- p3_batch(mats, W, 2L)
+  for (nm in c("expo", "error", "cosine", "p_val")) {
+    expect_true(isTRUE(all.equal(run1[[nm]], run2[[nm]])),
+      info = paste("parallel repro:", nm))
+  }
+})
diff --git a/tests/testthat/test-sig-fit-refit-flatcells.R b/tests/testthat/test-sig-fit-refit-flatcells.R
new file mode 100644
index 00000000..4f9157c7
--- /dev/null
+++ b/tests/testthat/test-sig-fit-refit-flatcells.R
@@ -0,0 +1,76 @@
+## Flat-signature cell family (the documented SBS5/40-style failure mode,
+## msuiter docs/research/00-executive-summary.md:30). The P3 acceptance law:
+## the two new methods must not regress these cells below the legacy route.
+##
+## Fixture: hand-built near-flat family over {D uniform, E tilted, F decoy}
+## with a 0.2 D + 0.8 E mixture (single column cannot carry the mix -- only
+## the pair fits it, cf. /tmp/p3refit/logs/03b-nullcal-probe.log -- so this
+## cell punishes any decision layer that drops too much of the flat mass).
+##
+## A-priori margins fixed before implementation:
+##   - capture_new >= capture_legacy - 0.15 (share points; the new methods
+##     must stay within 15 points of the legacy route's flat-mass capture)
+##   - capture_new >= 0.70 (absolute floor: the planted flat mass must stay
+##     majority-owned by the flat family even at the known failure mode)
+##   - no non-flat column may eat more than 0.10 of the mix
+
+p3_flat_capture <- function(catalogs, Wsub, method, ...) {
+  e <- suppressMessages(suppressWarnings(
+    do.call(sig_fit, c(
+      list(catalogue_matrix = catalogs, sig = Wsub, method = method),
+      list(...)
+    ))
+  ))
+  rel <- p3_normalize(e)
+  ## mean share of the mix owned by the flat family columns D and E
+  mean(rel["D", ] + rel["E", ])
+}
+
+test_that("flat cells: new methods hold flat-mass capture within the margins", {
+  W <- p3_refit_sig()
+  Wsub <- W[, c("D", "E", "F"), drop = FALSE]
+  base::set.seed(40404, kind = "L'Ecuyer-CMRG")
+  catalogs <- do.call(cbind, lapply(seq_len(8L), function(i) {
+    d <- as.integer(rmultinom(1L, 1000L,
+      prob = as.numeric(0.2 * Wsub[, "D"] + 0.8 * Wsub[, "E"])))
+    out <- matrix(d, ncol = 1L)
+    dimnames(out) <- list(rownames(Wsub), paste0("flat", i))
+    out
+  }))
+  cap_legacy <- p3_flat_capture(catalogs, Wsub, "QP")
+  expect_gte(cap_legacy, .85) ## the fixture itself must be well-formed
+  for (method in c("likelihood", "lrt")) {
+    cap <- p3_flat_capture(catalogs, Wsub, method)
+    expect_true(all(is.finite(as.matrix(
+      suppressMessages(suppressWarnings(
+        sig_fit(catalogs, sig = Wsub, method = method)
+      ))
+    ))))
+    expect_gte(cap, cap_legacy - 0.15, label = paste(method, "vs legacy capture"))
+    expect_gte(cap, 0.70, label = paste(method, "absolute flat floor"))
+    ## The decoy must not eat the mix.
+    e <- suppressMessages(suppressWarnings(
+      sig_fit(catalogs, sig = Wsub, method = method)
+    ))
+    rel <- p3_normalize(e)
+    expect_lte(max(rel["F", ]), 0.10, label = paste(method, "decoy share"))
+  }
+})
+
+test_that("flat cells: likelihood route keeps the calibrated pruning verdict", {
+  ## On the deterministic 0.2 D + 0.8 E cell the calibrated defaults must
+  ## keep E (removal cost 40.98) and prune D (cost 2.805 < ll_keep 8.0)
+  ## and F (cost 0), while all flat mass remains captured on {E} alone.
+  W <- p3_refit_sig()
+  Wsub <- W[, c("D", "E", "F"), drop = FALSE]
+  catalog <- p3_refit_catalog(c(D = .2, E = .8))
+  dimnames(catalog)[[1]] <- rownames(Wsub)
+  e <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = Wsub, method = "likelihood")
+  ))
+  abs <- as.numeric(e)
+  names(abs) <- rownames(e)
+  expect_equal(abs[["D"]], 0)
+  expect_equal(abs[["F"]], 0)
+  expect_gt(abs[["E"]], 990)
+})
diff --git a/tests/testthat/test-sig-fit-refit-likelihood.R b/tests/testthat/test-sig-fit-refit-likelihood.R
new file mode 100644
index 00000000..f4ceb8d8
--- /dev/null
+++ b/tests/testthat/test-sig-fit-refit-likelihood.R
@@ -0,0 +1,175 @@
+## method = "likelihood" (MuSiCal-branch semantics, P3 refit lane).
+##
+## Primary-source gate: /tmp/p3refit/logs/00-primary-source-gate.md sec. 1 --
+## "Matching and refitting with multinomial likelihood-based sparse NNLS."
+## "bidirectional stepwise algorithm"; acceptance thresholds are
+## study-optimized parameters ("two likelihood thresholds were optimized",
+## "optimal threshold was chosen through a grid search") and are therefore
+## exposed as arguments here rather than hard-coded.
+
+## The shared p3_check_method_argument contract helper lives in
+## helper-refit-synthetic.R so both refit-method families pin it identically.
+
+test_that("method='likelihood' resolves through the house match.arg idiom", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5))
+  p3_check_method_argument(catalog, W, exact = "likelihood", partial = "li")
+})
+
+test_that("method='likelihood' keeps the two true signatures of a clean mix", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5))
+  expo <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  expect_true(is.matrix(expo))
+  expect_equal(dim(expo), c(6L, 1L))
+  expect_equal(rownames(expo), colnames(W))
+  rel <- as.numeric(expo) / sum(as.numeric(expo))
+  names(rel) <- rownames(expo)
+  ## True signatures carry the bulk of the exposure ...
+  expect_gt(rel[["A"]], .30)
+  expect_gt(rel[["B"]], .30)
+  expect_lt(abs(rel[["A"]] - rel[["B"]]), .10)
+  ## ... and every irrelevant reference is fully dropped.
+  expect_equal(as.numeric(expo[c("C", "D", "E", "F"), ]), rep(0, 4))
+})
+
+test_that("method='likelihood' selects the single true spike", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(C = 1))
+  expo <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  rel <- as.numeric(expo)
+  names(rel) <- rownames(expo)
+  expect_gt(rel[["C"]], .90)
+  ## unname(): the slice inherits the matrix row names; the pin is on values.
+  expect_equal(unname(rel[rel != rel[["C"]]]), rep(0, 5))
+})
+
+test_that("ll_keep/ll_add are real parameters with the calibrated semantics", {
+  W <- p3_refit_sig()
+  ## Deterministic flat-family cell (0.2 D + 0.8 E). Fixture refit costs were
+  ## measured pre-implementation in /tmp/p3refit/logs/03c-stepwise-calibration
+  ## .log: removal-cost of E is 40.98 (>= the calibrated ll_keep 8), removal of
+  ## D costs 2.805 and of F 0.0 (both < 8), and the E-alone gain over the
+  ## empty reference is 38.17 (>= the calibrated ll_add 8), every other single
+  ## column gain is far below it.
+  catalog <- p3_refit_catalog(c(D = .2, E = .8))
+  kept_names <- function(...) {
+    e <- suppressMessages(suppressWarnings(
+      sig_fit(catalog, sig = W, method = "likelihood", ...)
+    ))
+    v <- as.numeric(e)
+    names(v) <- rownames(e)
+    sort(names(v[v > 0]))
+  }
+  ## (a) Calibration pin: at the defaults the sweep prunes D and F and keeps
+  ## the only member whose removal is significant at the gate: exactly {E}.
+  expect_equal(kept_names(), "E")
+  ## (b) Never-drop equivalence: with an unfireable keep-gate (ll_keep = -1,
+  ## no removal cost is negative) the decision layer keeps the full reference
+  ## set, so its refit must be exactly the legacy QP route's answer (the same
+  ## QP simplex engine, no selection delta).
+  e_full <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood", ll_add = 1e9, ll_keep = -1)
+  ))
+  e_qp <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "QP")
+  ))
+  expect_equal(as.numeric(e_full), as.numeric(e_qp), tolerance = 1e-12)
+  ## (c) Total-collapse recovery: a keep-gate no member can pass empties the
+  ## set; the forward gate then re-admits exactly what clears ll_add against
+  ## the empty reference -- per the 03c measurements that is E alone.
+  expect_equal(kept_names(ll_keep = 1e9), "E")
+})
+
+test_that("ll_add is accepted as a paired threshold argument", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5))
+  a <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  b <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood",
+      ll_add = 8.0, ll_keep = 8.0
+    )
+  ))
+  expect_equal(as.numeric(a), as.numeric(b))
+})
+
+test_that("method='likelihood' is deterministic and seed-free", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .6, C = .4))
+  e1 <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  e2 <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  expect_equal(e1, e2)
+})
+
+test_that("method='likelihood' handles a zero-count sample like the legacy route", {
+  W <- p3_refit_sig()
+  zero <- matrix(0L, nrow = 30L, ncol = 1L)
+  dimnames(zero) <- list(rownames(W), "zero_smp")
+  ez <- suppressMessages(suppressWarnings(
+    sig_fit(zero, sig = W, method = "likelihood")
+  ))
+  expect_equal(as.numeric(ez), rep(0, 6))
+})
+
+test_that("method='likelihood' honors return_class and return_error like QP", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(B = .5, C = .5))
+  res <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood",
+      return_class = "data.table", return_error = TRUE
+    )
+  ))
+  expect_true(is.list(res))
+  expect_true(all(c("expo", "errors", "cosine") %in% names(res)))
+  expect_true(data.table::is.data.table(res$expo))
+  expect_equal(names(res$expo), c("sample", colnames(W)))
+  expect_equal(length(res$errors), 1L)
+  expect_equal(length(res$cosine), 1L)
+  expect_true(is.finite(res$cosine))
+})
+
+test_that("method='likelihood' rejects auto_reduce with an explicit error", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .5, B = .5))
+  x <- as.numeric(catalog)
+  ## House stop idiom: send_stop() raises a bare stop() and routes the human
+  ## text through a cli alert, which surfaces as a message condition. Pin the
+  ## refusal text at the direct entry point where no purrr wrapper can interfere.
+  expect_message(
+    expect_error(decompose_LIKELIHOOD(x, 0, "smp", W, auto_reduce = TRUE)),
+    "likelihood"
+  )
+  expect_message(
+    expect_error(decompose_LIKELIHOOD(x, 0, "smp", W, auto_reduce = TRUE)),
+    "auto_reduce"
+  )
+  ## Wiring pin: the refusal must also surface through the sig_fit route.
+  expect_error(
+    suppressMessages(sig_fit(catalog, sig = W,
+      method = "likelihood", auto_reduce = TRUE
+    ))
+  )
+})
+
+test_that("method='likelihood' absolute exposures track the planted counts", {
+  W <- p3_refit_sig()
+  catalog <- p3_refit_catalog(c(A = .6, C = .4), total = 1000L)
+  expo <- suppressMessages(suppressWarnings(
+    sig_fit(catalog, sig = W, method = "likelihood")
+  ))
+  abs_expo <- as.numeric(expo)
+  names(abs_expo) <- rownames(expo)
+  expect_lt(abs(abs_expo[["A"]] - 600), 60)
+  expect_lt(abs(abs_expo[["C"]] - 400), 60)
+  expect_lt(abs(sum(abs_expo) - 1000), 5)
+})
