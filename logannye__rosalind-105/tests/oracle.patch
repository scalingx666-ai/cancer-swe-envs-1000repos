+        assert!(parse_block(&raw_block(2, 5, b"abc", 3)).is_err());
+    }
+    #[test]
+    fn fai_and_crai_refuse_unbounded_lines_and_bad_declared_coordinates() {
+        let huge = Temp::new(&vec![b'\t'; FAI_LINE_CAP as usize + 1]);
