+    # Render the PDF report from vaxrank's HTML output using WeasyPrint, rather
+    # than using vaxrank's own --output-pdf-report. vaxrank 1.4.0 produces PDFs
+    # via pdfkit -> wkhtmltopdf, and wkhtmltopdf was archived upstream in 2023.
+    # WeasyPrint is maintained, needs no X server, and runs against the image's
+    # system Python (see docker/Dockerfile), so vaxrank's Python 3.7 env does not
+    # constrain it. The stylesheet compensates for the layout tuning that was
+    # previously passed to wkhtmltopdf as pdfkit options.
+    rule vaccine_peptide_report_pdf:
+      input:
+        join(WORKDIR, "vaccine-peptide-report_{mhc_predictor}_{vcf_types}.html")
+      output:
+        join(WORKDIR, "vaccine-peptide-report_{mhc_predictor}_{vcf_types}.pdf")
+      log:
+        join(LOGDIR, "vaccine_peptide_report_pdf_{mhc_predictor}_{vcf_types}.log")
+      shell:
+        # vaxrank's HTML template links two stylesheets from Yahoo's retired YUI
+        # CDN over plain HTTP. Strip them so rendering requires no network and is
+        # deterministic; vaccine_report_pdf.css supplies the base styling instead.
+        #
+        # sed feeds WeasyPrint on stdin ("-") rather than via a temp file: snakemake
+        # runs this under `set -euo pipefail`, so a non-zero weasyprint exit aborts
+        # the shell immediately and any cleanup placed after it would never run.
+        "sed '/yui\\.yahooapis\\.com/d' {input} | "
+        "weasyprint --stylesheet $SCRIPTS/vaccine_report_pdf.css "
+        "--base-url {input} - {output} > {log} 2>&1"
+
     rule annotated_all_passing_variants:
       input:
         vcfs = _get_vaxrank_input_vcfs,
